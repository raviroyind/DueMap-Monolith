{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=DueMap;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "",
    "FromName": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=(localdb)\\mssqllocaldb;Database=DueMap;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
          "restrictedToMinimumLevel": "Information",
          "sinkOptionsSection": {
            "tableName": "events",
            "schemaName": "logs",
            "autoCreateSqlTable": false,
            "batchPostingLimit": 50,
            "batchPeriod": "0.00:00:05"
          },
          "columnOptionsSection": {
            "disableTriggers": true,
            "addStandardColumns": [ "LogEvent" ],
            "removeStandardColumns": [ "MessageTemplate" ],
            "timeStamp": {
              "columnName": "timestamp",
              "convertToUtc": true
            },
            "level": {
              "columnName": "level",
              "storeAsEnum": false
            },
            "logEvent": {
              "columnName": "log_event",
              "excludeAdditionalProperties": true
            },
            "message": { "columnName": "message" },
            "exception": { "columnName": "exception" },
            "properties": { "columnName": "properties" },
            "additionalColumns": [
              {
                "ColumnName": "pm_id",
                "DataType": "Int",
                "AllowNull": true,
                "PropertyName": "PmId"
              },
              {
                "ColumnName": "run_id",
                "DataType": "BigInt",
                "AllowNull": true,
                "PropertyName": "RunId"
              },
              {
                "ColumnName": "business_date",
                "DataType": "Date",
                "AllowNull": true,
                "PropertyName": "BusinessDate"
              },
              {
                "ColumnName": "source_context",
                "DataType": "NVarChar",
                "DataLength": 400,
                "AllowNull": true,
                "PropertyName": "SourceContext"
              }
            ]
          }
        }
      }
    ]
  }
}
