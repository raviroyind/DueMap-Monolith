@using DueMap.Web.Services
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    @* viewport-fit=cover lets env(safe-area-inset-*) resolve to real values on
       notched devices; without it they are always 0 and the notch clips content. *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <title>DueMap</title>

    @* Theme bootstrap FIRST — applies the saved light/dark class before paint
       (no flash) and exposes window.DueMapTheme for the toggle. *@
    <script src="js/theme.js"></script>

    @* Cache-busted by the compiled asset's own mtime. Tailwind rewrites app.css
       on every build, and without this the browser keeps serving the previous
       copy — you rebuild, reload, and see stale styling with no clue why. *@
    <link rel="stylesheet" href="css/app.css?v=@AssetVersion.Css" />

    @* Medium Editor — WYSIWYG body editor for the notice-template modal.
       Self-hosted (pinned v5.23.3) so it works offline in dev/Docker and carries
       no runtime third-party CDN dependency. duemap-editor.css layers our
       light/dark tweaks on top of the default theme. *@
    <link rel="stylesheet" href="lib/medium-editor/css/medium-editor.min.css" />
    <link rel="stylesheet" href="lib/medium-editor/css/default.min.css" />
    <link rel="stylesheet" href="lib/medium-editor/duemap-editor.css" />

    <script src="lib/apexcharts/apexcharts.min.js"></script>
    <script src="js/duemap-charts.js"></script>
    <script src="js/template-editor.js"></script>
    <script src="lib/medium-editor/medium-editor.min.js"></script>
    <script src="js/medium-editor-interop.js"></script>

    @* driver.js — guided onboarding tour. Pinned to a specific version from
       jsDelivr. Production deployments should self-host these two files under
       wwwroot/lib/driver.js/ and add an SRI integrity hash — pulling unpinned
       JS from a third-party CDN at runtime is a supply-chain risk. *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.css" />
    <script src="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.js.iife.js"></script>
    <script src="js/duemap-tour.js"></script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
@* Body colour + font come from the Osen base layer (bg-app / text-base / Inter);
   no hard-coded palette here so the theme tokens own light↔dark. *@
<body class="h-full antialiased">
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
