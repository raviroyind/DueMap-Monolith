@using Microsoft.AspNetCore.Components.Routing
@using DueMap.Common.FeatureFlags
@using DueMap.Web.Services
@inject IFeatureFlags Flags
@inject PmContext Pm

<nav class="flex-1 py-2 overflow-y-auto">
    <div data-tour="sidebar-setup">
        <div class="side-title">Workspace</div>
        <ul>
            <li>
                <NavLink class="side-link ic-today" ActiveClass="active" href="today">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
                    Today
                </NavLink>
            </li>
            <li>
                <NavLink class="side-link ic-dashboard" ActiveClass="active" href="" Match="NavLinkMatch.All">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                    Dashboard
                </NavLink>
            </li>
            <li>
                <NavLink class="side-link ic-assistant" ActiveClass="active" href="assistant">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/></svg>
                    Assistant
                </NavLink>
            </li>
            <li>
                <NavLink class="side-link ic-accounting" ActiveClass="active" href="connections">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 1 1 0 10h-2"/><line x1="8" x2="16" y1="12" y2="12"/></svg>
                    Accounting
                </NavLink>
            </li>
            <li>
                <NavLink class="side-link ic-notice" ActiveClass="active" href="notice-preferences">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/></svg>
                    Notice preferences
                </NavLink>
            </li>
            <li>
                <NavLink class="side-link ic-templates" ActiveClass="active" href="templates">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                    Templates
                </NavLink>
            </li>
        </ul>
    </div>

    <div data-tour="sidebar-portfolio">
        <div class="side-title">Portfolio</div>
        <ul>
            @if (_tenantsScreen)
            {
                <li>
                    <NavLink class="side-link ic-tenants" ActiveClass="active" href="tenants">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        Tenants
                    </NavLink>
                </li>
            }
            else
            {
                <li>
                    <NavLink class="side-link ic-leases" ActiveClass="active" href="leases">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
                        Leases
                    </NavLink>
                </li>
            }
            <li>
                <NavLink class="side-link ic-invoices" ActiveClass="active" href="invoices">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
                    Invoices
                </NavLink>
            </li>
            @if (!_tenantsScreen)
            {
                <li>
                    <NavLink class="side-link ic-customers" ActiveClass="active" href="link-customers">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        Link customers
                    </NavLink>
                </li>
            }
            <li>
                <NavLink class="side-link ic-processing" ActiveClass="active" href="processing-status">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.5.5 0 0 1-.96 0L9.24 3.18a.5.5 0 0 0-.96 0l-2.35 8.36A2 2 0 0 1 4 13H2"/></svg>
                    Processing status
                </NavLink>
            </li>
        </ul>
    </div>
</nav>

@code {
    // P1-5: when tenancy.tenants_screen is on, the unified "Tenants" link
    // replaces "Leases" + "Link customers" in the nav. Resolved per-PM so a
    // per-PM rollout flips the nav for exactly the enrolled workspaces.
    // Fail-safe: any error (no PM context yet, flag DB down) keeps the
    // classic links so navigation never breaks.
    private bool _tenantsScreen;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var pmId = await Pm.GetPmIdAsync();
            _tenantsScreen = await Flags.IsEnabledAsync("tenancy.tenants_screen", pmId, CancellationToken.None);
        }
        catch
        {
            _tenantsScreen = false;
        }
    }
}

@*
    NavLink renders ordinary anchor tags + adds the `active` class when matched.
    .menu-item / .menu-item.active are defined in the Osen component layer (app.css).
*@
