@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using DueMap.Integrations.Accounting
@using DueMap.Tenancy.Services
@using DueMap.Web.Components.Shared
@using DueMap.Web.Services
@inject IAccountingConnectionService ConnectionSvc
@inject IOnboardingProgressService OnboardingProgress
@inject PmContext Pm
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@implements IDisposable

@*
    Two-mode shell.

    Fully onboarded PM (all three onboarding steps complete):
        Full sidebar + topbar + page body. Everything you'd expect.

    Mid-onboarding PM (any of the three step timestamps is NULL):
        Kiosk mode. No sidebar, no nav, no escape hatch. The PM is
        bounced to the FIRST INCOMPLETE step's route. The OnboardingShell
        layout takes over for the actual step pages — this layout only
        renders for routes that AREN'T under /onboarding/*. The kiosk
        branch below is now mostly a safety net for users who try to
        deep-link past their progress.
*@

@* Action-feedback toasts float above the topbar in both shell modes. *@
<ToastHost />

@if (!_initialized)
{
    <div class="flex h-full min-h-screen items-center justify-center text-muted">
        Loading workspace…
    </div>
}
else if (_connected)
{
    <div class="flex h-full min-h-screen bg-app">

        @* Mobile drawer backdrop — tap anywhere to dismiss. Desktop never shows it. *@
        @if (_sidebarOpen)
        {
            <div class="fixed inset-0 z-40 bg-black/40 md:hidden" @onclick="CloseSidebar"></div>
        }

        <!-- SIDEBAR (Osen dark) — static column on desktop, slide-in drawer on mobile -->
        @* Slide state lives in .app-sidebar / .is-open (see input.css), not in
           Tailwind's translate utilities — those animate a var()-derived
           `translate` and leave the panel stuck off-canvas. *@
        <aside class="app-sidebar w-[260px] shrink-0 flex flex-col fixed inset-y-0 left-0 z-50 md:static @(_sidebarOpen ? "is-open" : "")">
            <div class="h-[70px] flex items-center gap-2.5 px-5 border-b sidebar-line shrink-0">
                <span class="brand-mark">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
                </span>
                <span class="text-[15px] font-semibold tracking-tight text-white">DueMap</span>
            </div>

            <NavMenu />

            <!-- User card -->
            <AuthorizeView>
                <Authorized>
                    <div class="border-t sidebar-line p-3 shrink-0">
                        <div class="side-link w-full" title="@context.User.Identity?.Name">
                            <span class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-semibold shrink-0" style="background:var(--sidebar-hover-bg);color:var(--sidebar-item-hover);">
                                @Initials(_orgName ?? context.User.Identity?.Name)
                            </span>
                            <span class="flex-1 min-w-0 text-left text-sm font-medium truncate" style="color:var(--sidebar-item-hover);">@(_orgName ?? context.User.Identity?.Name ?? "User")</span>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </aside>

        <!-- MAIN -->
        <div class="flex-1 flex flex-col min-w-0">

            <!-- TOPBAR -->
            <header class="sticky top-0 z-30 h-[70px] flex items-center justify-between px-4 sm:px-4 sm:px-6 lg:px-8 border-b border-line bg-surface gap-3">
                <div class="flex items-center gap-2 min-w-0">
                    <button type="button" class="btn btn-icon btn-sm btn-ghost md:hidden shrink-0" @onclick="ToggleSidebar" aria-label="Open menu">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
                    </button>
                    <h1 class="text-base font-semibold text-heading truncate">Property manager admin</h1>
                </div>
                <div class="flex items-center gap-2">
                    <AuthorizeView>
                        <Authorized>
                            @* Org name once the books are connected — the workspace
                               identity a PM recognizes; email is the fallback. *@
                            <span class="text-sm text-muted hidden md:inline" title="@context.User.Identity?.Name">@(_orgName ?? context.User.Identity?.Name)</span>
                            <form method="post" action="/Account/Logout">
                                <button type="submit" class="btn btn-sm btn-secondary">Sign out</button>
                            </form>
                        </Authorized>
                    </AuthorizeView>
                    <ThemeToggle />
                </div>
            </header>

            <main class="flex-1 overflow-y-auto">
                @Body
            </main>
        </div>
    </div>
}
else
{
    @* KIOSK MODE — no sidebar, no app nav. Only the brand mark and a sign-out
       affordance live in the header so the user isn't trapped. *@
    <div class="min-h-screen flex flex-col bg-app">
        <header class="sticky top-0 z-30 h-14 flex items-center justify-between gap-2 px-4 sm:px-6 lg:px-8 border-b border-line bg-surface">
            <div class="flex items-center gap-2.5">
                <span class="brand-mark">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
                </span>
                <span class="text-[15px] font-semibold tracking-tight text-heading">DueMap</span>
            </div>
            <div class="flex items-center gap-2">
                <AuthorizeView>
                    <Authorized>
                        <span class="text-sm text-muted hidden md:inline">@context.User.Identity?.Name</span>
                        <form method="post" action="/Account/Logout">
                            <button type="submit" class="btn btn-sm btn-secondary">Sign out</button>
                        </form>
                    </Authorized>
                </AuthorizeView>
                <ThemeToggle />
            </div>
        </header>
        <main class="flex-1 overflow-y-auto">
            @Body
        </main>
    </div>
}

@code {
    private bool _initialized;
    private bool _connected;

    // v28: the accounting organisation name ("Sandbox Company_US_2") shown as
    // the workspace identity in the topbar + sidebar footer. Null until the
    // books are connected (or for pre-v28 connections until sync backfills it),
    // in which case the signed-in email renders instead.
    private string? _orgName;

    // Mobile nav drawer. Hidden on desktop (md+), where the sidebar is a static
    // column. On mobile the hamburger toggles it; navigating or tapping the
    // backdrop closes it.
    private bool _sidebarOpen;
    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar() => _sidebarOpen = false;

    // Serialises EvaluateAsync — rapid navigation fires multiple
    // OnLocationChanged events, and each calls into IAccountingConnectionService
    // which uses a scoped IntegrationsDbContext. DbContext isn't thread-safe;
    // running two evaluations concurrently throws "A second operation was
    // started on this context instance." Latest nav still wins because each
    // event awaits its turn rather than being dropped.
    private readonly SemaphoreSlim _evaluateLock = new(1, 1);

    // Routes that the onboarding flow itself owns. If the PM is mid-onboarding
    // and ALREADY navigating to one of these, leave them alone — the
    // OnboardingShell layout (not us) renders those pages, and the kiosk
    // router below will redirect them to the right step if they picked the
    // wrong one for their current progress.
    private static readonly string[] OnboardingPaths =
    {
        "/onboarding/connect",
        "/onboarding/syncing",
        "/onboarding/close-settings",
        "/onboarding/notice-preferences",
        "/onboarding/preflight"
    };

    // Legacy /connections is still reachable post-onboarding for "manage
    // connection" — but during kiosk we send users to /onboarding/connect.

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await EvaluateAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Tapping a nav item navigates — close the mobile drawer so the page is
        // visible (no-op on desktop where it's never open).
        _sidebarOpen = false;

        // Serialise via the semaphore so rapid clicks don't fire two
        // EvaluateAsync calls onto the same scoped IntegrationsDbContext.
        await _evaluateLock.WaitAsync();
        try
        {
            await InvokeAsync(EvaluateAsync);
        }
        finally
        {
            _evaluateLock.Release();
        }
    }

    private async Task EvaluateAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated != true)
        {
            // Anonymous — auth middleware will redirect to /Account/Login.
            _initialized = true;
            StateHasChanged();
            return;
        }

        var pmId = await Pm.GetPmIdAsync();

        // Single source of truth for routing: the three onboarding step
        // timestamps. Done == let them into the full app. Not done == bounce
        // to whichever step is still pending.
        var progress = await OnboardingProgress.GetAsync(pmId, CancellationToken.None);
        _connected = progress.IsComplete;

        if (_connected)
        {
            var conn = await ConnectionSvc.GetActiveAsync(pmId, CancellationToken.None);
            _orgName = string.IsNullOrWhiteSpace(conn?.CompanyName) ? null : conn!.CompanyName;
        }

        if (!_connected)
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            if (path.Length == 0) path = "/";

            // Already heading somewhere under /onboarding/* — the OnboardingShell
            // layout will render the page. We additionally enforce ordering so
            // a PM can't deep-link to step 3 without finishing step 2: if their
            // current URL is FURTHER than their first incomplete step, rewrite
            // back to that step.
            var nextRoute = RouteFor(progress.NextStep);
            var isOnboardingPath = OnboardingPaths.Any(p =>
                string.Equals(path, p, StringComparison.OrdinalIgnoreCase));

            if (!isOnboardingPath)
            {
                Nav.NavigateTo(nextRoute, replace: true);
                return;
            }

            // They're on /onboarding/* but it's not the step they should be on.
            // /onboarding/syncing is exempt — it's a transient page that runs
            // between Connect and CloseSettings and may legitimately be loaded
            // before its predecessor step is stamped done.
            if (!string.Equals(path, "/onboarding/syncing", StringComparison.OrdinalIgnoreCase)
             && !string.Equals(path, nextRoute,             StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo(nextRoute, replace: true);
                return;
            }
        }

        _initialized = true;
        StateHasChanged();
    }

    private static string RouteFor(OnboardingStep? step) => step switch
    {
        OnboardingStep.Connect           => "/onboarding/connect",
        OnboardingStep.CloseSettings     => "/onboarding/close-settings",
        OnboardingStep.NoticePreferences => "/onboarding/notice-preferences",
        OnboardingStep.Preflight         => "/onboarding/preflight",
        _                                => "/"     // shouldn't happen — defensive
    };

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _evaluateLock.Dispose();
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "·";
        var local = name.Split('@')[0];
        var parts = local.Split(new[] { '.', '_', '-', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return char.ToUpperInvariant(local[0]).ToString();
        if (parts.Length == 1) return char.ToUpperInvariant(parts[0][0]).ToString();
        return string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[1][0]));
    }
}
