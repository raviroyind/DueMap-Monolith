@inherits LayoutComponentBase

@*
    Minimal chrome for developer-only admin pages (currently just
    /admin/worker-logs).

    Cannot share MainLayout because that layout assumes the caller is a
    signed-in PM and resolves a PmId claim from the principal — and the
    Basic-Auth gate fronting /admin/* synthesizes a bare ClaimsPrincipal
    with no PmId. We deliberately keep this layout free of any PmContext
    or tenant lookups so admin tooling never depends on PM state.
*@

<div class="min-h-screen bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100">
    <header class="border-b border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-900">
        <div class="max-w-7xl mx-auto px-8 h-14 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-indigo-500 to-indigo-700 flex items-center justify-center shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
                </div>
                <span class="text-sm font-semibold tracking-tight">DueMap</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-medium uppercase tracking-wider text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10">
                    Internal admin
                </span>
            </div>
            <div class="text-xs text-zinc-500">Developer view — not customer-facing</div>
        </div>
    </header>

    <main>
        @Body
    </main>
</div>
