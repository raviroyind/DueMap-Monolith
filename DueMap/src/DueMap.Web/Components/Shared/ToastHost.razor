@using DueMap.Web.Services
@implements IDisposable
@inject ToastService Toast

@*
    Floating toast stack. Fixed at the very top of the viewport, horizontally
    centred, ABOVE the topbar and sidebar (z-[100] beats the sidebar's z-50 /
    topbar's z-30 / modal overlays' z-50). Every layout renders one of these
    so action feedback looks identical everywhere. Each toast self-dismisses
    after its duration; the × dismisses early.
*@

<div class="fixed top-3 inset-x-0 z-[100] flex flex-col items-center gap-2 px-4 pointer-events-none">
    @foreach (var t in Toast.Items)
    {
        <div @key="t.Id"
             class="toast-item pointer-events-auto flex items-start gap-2.5 max-w-xl rounded-lg border border-line bg-surface shadow-pop px-4 py-3 text-sm">
            @switch (t.Level)
            {
                case ToastLevel.Success:
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="text-success mt-0.5 shrink-0"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/></svg>
                    break;
                case ToastLevel.Info:
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-info mt-0.5 shrink-0"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                    break;
                case ToastLevel.Warning:
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-warning mt-0.5 shrink-0"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                    break;
                default:
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="text-danger mt-0.5 shrink-0"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                    break;
            }
            <div class="text-body leading-relaxed min-w-0">@t.Message</div>
            <button type="button" aria-label="Dismiss"
                    class="shrink-0 -mr-1 mt-0.5 text-muted hover:text-heading transition-colors"
                    @onclick="() => Toast.Remove(t.Id)">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </div>
    }
</div>

@code {
    // One dismiss timer per toast id — Changed fires on every add AND remove,
    // so guard against double-scheduling.
    private readonly HashSet<Guid> _scheduled = new();

    protected override void OnInitialized()
    {
        Toast.Changed += OnChanged;
        ScheduleDismissals();
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        ScheduleDismissals();
        StateHasChanged();
    });

    private void ScheduleDismissals()
    {
        foreach (var t in Toast.Items)
        {
            if (_scheduled.Add(t.Id))
            {
                _ = DismissLaterAsync(t);
            }
        }
    }

    private async Task DismissLaterAsync(ToastItem t)
    {
        await Task.Delay(t.DurationMs);
        _scheduled.Remove(t.Id);
        // Remove fires Changed, which marshals the re-render via InvokeAsync.
        Toast.Remove(t.Id);
    }

    public void Dispose() => Toast.Changed -= OnChanged;
}
