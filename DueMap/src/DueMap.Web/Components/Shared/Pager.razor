@*
    Shared grid pager. Renders nothing when everything fits on one page, so
    small workspaces never see chrome they don't need.

    Owner page keeps the state (Page, PageSize) and slices its own rows; this
    component only renders the controls and raises PageChanged. Pages are
    ZERO-based to match the existing Tenants grid.
*@

@if (TotalItems > PageSize)
{
    <div class="px-6 py-3 border-t border-line flex items-center justify-between gap-3 flex-wrap">
        <div class="text-xs text-muted tabular-nums">
            Showing <span class="font-medium text-heading">@(FirstItemNumber)–@(LastItemNumber)</span>
            of <span class="font-medium text-heading">@TotalItems</span> @(ItemNoun)@(TotalItems == 1 ? "" : "s")
        </div>
        <div class="flex items-center gap-1.5">
            <button type="button" class="btn btn-sm btn-secondary"
                    disabled="@(Page <= 0)" @onclick="() => GoTo(0)" title="First page">«</button>
            <button type="button" class="btn btn-sm btn-secondary"
                    disabled="@(Page <= 0)" @onclick="() => GoTo(Page - 1)">Prev</button>
            <span class="text-xs text-muted tabular-nums px-2">Page @(Page + 1) of @TotalPages</span>
            <button type="button" class="btn btn-sm btn-secondary"
                    disabled="@(Page >= TotalPages - 1)" @onclick="() => GoTo(Page + 1)">Next</button>
            <button type="button" class="btn btn-sm btn-secondary"
                    disabled="@(Page >= TotalPages - 1)" @onclick="() => GoTo(TotalPages - 1)" title="Last page">»</button>
        </div>
    </div>
}

@code {
    /// <summary>Zero-based current page.</summary>
    [Parameter, EditorRequired] public int Page { get; set; }

    [Parameter, EditorRequired] public int PageSize { get; set; }

    /// <summary>Total rows AFTER search/filter, before slicing.</summary>
    [Parameter, EditorRequired] public int TotalItems { get; set; }

    [Parameter] public EventCallback<int> PageChanged { get; set; }

    /// <summary>Singular noun for the range label ("lease", "invoice"…).</summary>
    [Parameter] public string ItemNoun { get; set; } = "row";

    public int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalItems / (double)PageSize));

    private int FirstItemNumber => TotalItems == 0 ? 0 : Page * PageSize + 1;
    private int LastItemNumber  => Math.Min(TotalItems, (Page + 1) * PageSize);

    private Task GoTo(int page)
    {
        var clamped = Math.Clamp(page, 0, TotalPages - 1);
        return clamped == Page ? Task.CompletedTask : PageChanged.InvokeAsync(clamped);
    }
}
