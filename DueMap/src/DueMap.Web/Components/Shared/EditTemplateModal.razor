@*
    EditTemplateModal — inline editor for a single PM template override.

    Triggered from anywhere that has a "this is the template for X" affordance
    (e.g. the Edit template buttons on /notice-preferences). Keeps the user on
    their current page instead of routing to /templates and losing context.

    Scope: edits the PM-generic override (state_id = null) for the given
    notice_type_code. State-specific overrides live on /templates where the
    full grid is the right surface — that page handles the multi-state matrix.
    This modal is for the 80% case: "I want to tweak the words for this kind
    of notice across my portfolio."

    Parent control: parent calls Show(noticeTypeCode, friendlyName). The modal
    handles its own visibility, loading, save, and dismiss; the parent gets a
    notification via OnSaved when an override was persisted, so it can refresh
    any downstream "last edited" indicators.
*@
@using DueMap.Notices
@using DueMap.Notices.Domain
@using DueMap.Rules
@using RulesState = DueMap.Rules.Domain.State
@using Microsoft.JSInterop
@using Scriban
@using Scriban.Runtime
@inject INoticeTemplateService TemplateResolver
@inject IPmTemplateOverrideService Overrides
@inject INoticeTypeReader NoticeTypeReader
@inject IStateReader StateReader
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_visible && _draft is not null)
{
    <div class="fixed inset-0 z-50 bg-[rgb(49_58_70/0.35)] backdrop-blur-sm flex items-center justify-center p-0 md:p-6"
         @onclick="Close">
        @* Editor width: full-screen on mobile, ~70% of the viewport on desktop,
           so the rich-text body has room to breathe. *@
        <div class="card w-full h-full md:h-auto md:w-[70vw] md:max-w-[70vw] max-h-screen md:max-h-[90vh] shadow-modal flex flex-col"
             @onclick:stopPropagation="true">

            <!-- HEADER -->
            <header class="card-header flex items-center justify-between gap-3 shrink-0">
                <div class="min-w-0">
                    <h3 class="card-title">Edit template</h3>
                    <p class="card-subtitle">@_friendlyName · applies across your portfolio</p>
                </div>
                <button class="btn btn-icon btn-sm btn-ghost" @onclick="Close" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </header>

            <!-- BODY (scrolls if content exceeds modal height) -->
            <div class="px-6 py-5 space-y-5 overflow-y-auto flex-1 min-h-0">

                @* Type + State pickers — only when the caller asked for them
                   (Templates page). When opened from NoticePreferences the type
                   is fixed and these don't render. *@
                @if (_showPicker)
                {
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div>
                            <label class="form-label">Notice type</label>
                            <select value="@_draft.NoticeTypeId" @onchange="OnNoticeTypeChangedAsync" disabled="@(_draft.Id != 0)"
                                    class="form-select disabled:opacity-60 disabled:cursor-not-allowed">
                                @foreach (var t in _noticeTypes)
                                {
                                    <option value="@t.Id">@t.DisplayName (@t.Code)</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">State (optional)</label>
                            <select value="@(_draft.StateId?.ToString() ?? "")" @onchange="OnStateChangedAsync" disabled="@(_draft.Id != 0)"
                                    class="form-select disabled:opacity-60 disabled:cursor-not-allowed">
                                <option value="">All states (generic)</option>
                                @foreach (var s in _states)
                                {
                                    <option value="@s.Id">@s.Code — @s.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_hint))
                {
                    <div class="alert alert-primary items-start justify-between">
                        <div class="flex items-start gap-2.5 min-w-0">
                            <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                            <div class="text-xs leading-relaxed">@_hint</div>
                        </div>
                        <button type="button" @onclick="ResetToDefaultAsync" class="btn-link text-xs shrink-0">
                            Reset to default
                        </button>
                    </div>
                }

                <div>
                    <label for="tpl-subject" class="form-label">Subject</label>
                    <input id="tpl-subject" type="text" @bind="_draft.Subject" @bind:event="oninput"
                           @onfocus="@(() => _focusedFieldId = "tpl-subject")"
                           maxlength="400" class="form-control" />
                </div>

                @* Theme picker — swatches drive the Preview tab's chrome. v1 is
                   preview-only; the saved BodyHtml is still the bare body that
                   the existing send pipeline emits. Wiring chrome into actual
                   sends is a follow-up (schema + renderer change). *@
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="form-label mb-0">Email design</label>
                        <span class="text-[10px] uppercase tracking-wider font-medium text-muted">Preview only</span>
                    </div>
                    <div class="flex items-center gap-2 flex-wrap">
                        @foreach (var theme in EmailThemes.All)
                        {
                            var selected = theme.Key == _themeKey;
                            <button type="button"
                                    @onclick="@(() => _themeKey = theme.Key)"
                                    title="@theme.Label"
                                    class="@(selected
                                        ? "ring-2 ring-offset-2 ring-primary"
                                        : "ring-1 ring-[color:var(--line)] hover:ring-2")
                                        inline-flex items-center gap-2 h-9 px-3 rounded-field text-xs font-medium bg-surface text-heading transition-shadow duration-150">
                                <span class="w-4 h-4 rounded-full shrink-0" style="background:@theme.AccentHex"></span>
                                <span>@theme.Label</span>
                            </button>
                        }
                    </div>
                </div>

                <div>
                    <label for="tpl-html-body" class="form-label mb-2">HTML body</label>

                    @* Underline-style tabs: a shared bottom rule with the active
                       tab marked by a primary underline that overlaps the rule
                       (-mb-px). Reads as classic tabs rather than a pill toggle. *@
                    <div class="flex items-center gap-1 border-b border-line mb-3">
                        <button type="button" @onclick="@(() => _htmlTab = HtmlTab.Design)"
                                class="@(_htmlTab == HtmlTab.Design
                                    ? "border-primary text-primary"
                                    : "border-transparent text-muted hover:text-heading")
                                    inline-flex items-center gap-2 px-4 py-2.5 -mb-px border-b-2 font-semibold text-sm transition-colors duration-150">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>
                            Design
                        </button>
                        <button type="button" @onclick="ShowPreviewAsync"
                                class="@(_htmlTab == HtmlTab.Preview
                                    ? "border-primary text-primary"
                                    : "border-transparent text-muted hover:text-heading")
                                    inline-flex items-center gap-2 px-4 py-2.5 -mb-px border-b-2 font-semibold text-sm transition-colors duration-150">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                            Preview
                        </button>
                    </div>

                    @if (_htmlTab == HtmlTab.Design)
                    {
                        @if (_editorFailed)
                        {
                            @* Degraded fallback: Medium Editor didn't load, so we
                               drop back to a raw-HTML textarea. Still editable —
                               just without the WYSIWYG niceties. *@
                            <textarea id="@BodyEditorId" @bind="_draft.BodyHtml" @bind:event="oninput"
                                      @onfocus="@(() => _focusedFieldId = BodyEditorId)"
                                      class="form-textarea w-full min-h-[45vh] md:min-h-[55vh] font-mono resize-y"></textarea>
                        }
                        else
                        {
                            @* Formatting affordance: Medium Editor's toolbar only
                               appears on selection, which isn't discoverable on its
                               own. This bar tells the PM the surface is rich-text and
                               how to summon the toolbar. *@
                            <div class="alert alert-primary mb-2">
                                <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 11-6 6v3h9l3-3"/><path d="m22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4"/></svg>
                                <p class="text-xs leading-relaxed">
                                    <span class="font-semibold">Highlight any text</span> to format it — a toolbar pops up with bold, italic, links, headings and lists.
                                </p>
                            </div>

                            @* WYSIWYG body. Content is owned by Medium Editor (wired
                               up in OnAfterRenderAsync) — deliberately NO @bind, or
                               Blazor's render diff would wipe the editor's DOM. C#
                               reads the value back via the OnBodyHtmlChanged callback
                               and pulls a final copy on save. *@
                            <div id="@BodyEditorId"
                                 class="rt-editor w-full min-h-[45vh] md:min-h-[55vh] px-3.5 py-3 rounded-field bg-surface text-sm border border-line transition-shadow duration-150"
                                 @onfocus="@(() => _focusedFieldId = BodyEditorId)"></div>
                        }
                    }
                    else
                    {
                        @* Email-style preview pane: the chosen theme's chrome wraps
                           the rendered body with sample data substituted. The inset
                           backdrop simulates the inbox surround so the chrome's own
                           shadow + radius are visible. *@
                        <div class="rounded-field border border-line bg-surface-2 p-4 min-h-[280px]">
                            @if (string.IsNullOrWhiteSpace(_draft.BodyHtml))
                            {
                                <p class="text-sm text-muted italic px-4 py-12 text-center">Nothing to preview yet.</p>
                            }
                            else
                            {
                                <div class="rt-editor">
                                    @((MarkupString)EmailThemes.Wrap(RenderPreview(_draft.BodyHtml), EmailThemes.Resolve(_themeKey)))
                                </div>
                            }
                            <p class="text-[11px] text-muted mt-3 px-1 text-center">
                                Sample data: <span class="font-medium">Jane Smith</span> · <span class="font-medium">$1,250.00</span> · <span class="font-medium">@SampleDueDate</span>. Real notices use the lease's actual values at send time.
                            </p>
                        </div>
                    }
                </div>

                <div class="flex items-start gap-2 flex-wrap">
                    <span class="text-xs text-muted pt-1 shrink-0">Insert placeholder:</span>
                    @foreach (var p in Placeholders)
                    {
                        <button type="button"
                                @onclick="@(() => InsertPlaceholderAsync(p.Token, asHtml: false))"
                                title="@p.Description — inserts at cursor in the last focused field"
                                class="badge badge-primary cursor-pointer hover:brightness-105 transition">
                            @p.Label
                        </button>
                    }
                </div>

                <div class="flex items-start gap-2 flex-wrap">
                    <span class="text-xs text-muted pt-1 shrink-0">Insert snippet:</span>
                    @foreach (var s in Snippets)
                    {
                        <button type="button"
                                @onclick="@(() => InsertPlaceholderAsync(s.Html, asHtml: true))"
                                title="@s.Description"
                                class="btn btn-sm btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                            @s.Label
                        </button>
                    }
                </div>
            </div>

            <!-- FOOTER -->
            <footer class="card-footer flex items-center justify-end gap-2 shrink-0">
                <button class="btn btn-ghost" @onclick="Close">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @(_saving ? "Saving…" : "Save template")
                </button>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public int PropertyManagerId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _visible;
    private bool _saving;
    private string _friendlyName = string.Empty;
    private string _noticeTypeCode = string.Empty;
    private int _noticeTypeId;
    private string? _hint;
    private PmTemplateOverride? _draft;

    // Picker mode (Templates page) shows notice-type + state dropdowns at the
    // top. Direct mode (NoticePreferences) hides them — the caller already
    // committed to a specific notice type.
    private bool _showPicker;
    private IReadOnlyList<NoticeType> _noticeTypes = Array.Empty<NoticeType>();
    private IReadOnlyList<RulesState> _states = Array.Empty<RulesState>();

    // DOM id of the rich-text body surface. Used both as the contenteditable's
    // id and as the Medium Editor interop handle. Kept as a const so the Razor
    // markup, the focus tracker, and the JS calls can't drift apart.
    private const string BodyEditorId = "tpl-html-body";

    // ID of the last text field the user focused (subject / html body). Used by
    // the placeholder chips to know which field to inject into. Default to the
    // HTML body — that's where copy gets edited most often. (The plain-text body
    // is no longer edited directly; it's derived from the rich HTML on save.)
    private string _focusedFieldId = BodyEditorId;

    // Medium Editor lifecycle. _editorInitialized tracks whether a live instance
    // is bound to the contenteditable; _editorFailed flips on if the library
    // didn't load (we then render a plain textarea fallback). _dotNetRef lets
    // the JS side push edits back into _draft.BodyHtml.
    private bool _editorInitialized;
    private bool _editorFailed;
    private DotNetObjectReference<EditTemplateModal>? _dotNetRef;

    private enum HtmlTab { Design, Preview }
    private HtmlTab _htmlTab = HtmlTab.Design;

    // Currently-selected email theme key (v1 = preview-only chrome wrapping).
    private string _themeKey = EmailThemes.DefaultKey;

    // Today + 5 days, formatted human-friendly. Used in the preview substitution
    // for {{ due_date }} so the rendered preview looks like a real upcoming notice.
    private static string SampleDueDate => DateTime.Today.AddDays(5).ToString("MMMM d, yyyy");

    // Sample values shown in the preview pane. Keep keys aligned with the
    // Placeholders catalogue above + required_vars on the seeded templates.
    private static readonly (string Key, string Value)[] SampleValues =
    {
        ("tenant_name",  "Jane Smith"),
        ("amount_owed",  "$1,250.00"),
        ("monthly_rent", "$1,250.00"),
        ("lease_id",     "L-00042"),
        ("grace_days",   "5"),
        ("pay_url",      "https://example.com/pay/sample-token")
    };

    /// <summary>
    /// Renders the preview in Scriban's LIQUID mode — the same dialect the
    /// send pipeline (ScribanNoticeRenderer) parses — so {{ var }}
    /// substitutions AND control flow like {% if pay_url %}…{% endif %} both
    /// evaluate exactly as a sent email would. (Native Template.Parse treats
    /// {% %} as plain text and printed the tags literally — QA P3.) We hand it
    /// a synthetic variable bag built from <see cref="SampleValues"/>; the
    /// real send pipeline gets its values from the lease + invoice rows.
    ///
    /// Errors are swallowed and the raw template is returned so a typo in
    /// a {{ }} tag never crashes the modal — the PM can spot the problem
    /// faster from the rendered glitch than from a stack trace.
    /// </summary>
    private static string RenderPreview(string html)
    {
        try
        {
            var template = Template.ParseLiquid(html);
            if (template.HasErrors) return html;

            var script = new ScriptObject();
            foreach (var (key, value) in SampleValues)
            {
                script[key] = value;
            }
            script["due_date"] = SampleDueDate;

            var context = new LiquidTemplateContext();
            context.PushGlobal(script);
            return template.Render(context);
        }
        catch
        {
            return html;
        }
    }

    private sealed record PlaceholderDef(string Label, string Token, string Description);

    // Catalogue surfaced as clickable chips. Keep in sync with required_vars
    // declared on the system templates (seed_notice_templates*.sql).
    private static readonly PlaceholderDef[] Placeholders =
    {
        new("tenant_name",  "{{ tenant_name }}",  "Tenant's full name"),
        new("amount_owed",  "{{ amount_owed }}",  "Amount currently owed (formatted as currency)"),
        new("due_date",     "{{ due_date }}",     "Rent due date for this lease"),
        new("monthly_rent", "{{ monthly_rent }}", "Monthly rent on the lease"),
        new("lease_id",     "{{ lease_id }}",     "Internal lease identifier"),
        new("grace_days",   "{{ grace_days }}",   "Effective grace period in days"),
        new("pay_url",      "{{ pay_url }}",      "Public payment URL from QuickBooks or Xero — tenant clicks to pay online")
    };

    private sealed record SnippetDef(string Label, string Html, string Description);

    // Pre-built HTML blocks PMs can drop into the body with one click. Bigger
    // than a token chip — these insert full styled markup. The Pay Now button
    // uses indigo as a neutral default; a future enhancement could pick up the
    // current theme's accent color.
    private static readonly SnippetDef[] Snippets =
    {
        new(
            "Pay Now button",
            // Verbatim string (not C# 11 raw) — Razor's compiler can't parse
            // triple-quoted literals inside @code reliably under .NET 8.
            // The {% if pay_url %} wrap means the button hides itself when
            // the invoice has no public payment URL (payments not enabled
            // in QuickBooks, or Xero's OnlineInvoice endpoint returned empty).
            "\n{% if pay_url %}\n" +
            "<p style=\"text-align:center;margin:24px 0;\">\n" +
            "  <a href=\"{{ pay_url }}\" style=\"display:inline-block;padding:12px 28px;background:#4F46E5;color:white;text-decoration:none;border-radius:8px;font-weight:600;font-size:14px;\">\n" +
            "    Pay rent online\n" +
            "  </a>\n" +
            "</p>\n" +
            "{% endif %}\n",
            "Inserts a styled button that links to the invoice's public payment URL. Auto-hides when the invoice has no pay link.")
    };

    // -- Medium Editor lifecycle -------------------------------------------

    /// <summary>
    /// Spins the WYSIWYG editor up/down to follow the visible Design surface.
    /// The contenteditable only exists when the modal is open AND the Design tab
    /// is active, so we (re)initialise whenever it appears and tear down when it
    /// leaves (tab switch to Preview, or modal close). Re-init seeds from the
    /// current draft, which OnBodyHtmlChanged keeps in sync.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_editorFailed) return;

        var wantEditor = _visible && _draft is not null && _htmlTab == HtmlTab.Design;

        if (wantEditor && !_editorInitialized)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            var ok = await JS.InvokeAsync<bool>(
                "dueMapEditor.init", BodyEditorId, _dotNetRef, _draft!.BodyHtml ?? string.Empty);
            if (ok)
            {
                _editorInitialized = true;
            }
            else
            {
                // Library missing — fall back to the raw textarea on next render.
                _editorFailed = true;
                StateHasChanged();
            }
        }
        else if (_editorInitialized && !wantEditor)
        {
            await JS.InvokeVoidAsync("dueMapEditor.destroy", BodyEditorId);
            _editorInitialized = false;
        }
    }

    /// <summary>
    /// Called from JS whenever the PM edits the body. The contenteditable is
    /// JS-owned, so this is the only path that mutates _draft.BodyHtml from the
    /// editor. No StateHasChanged: the Design surface isn't Blazor-rendered, and
    /// the Preview tab re-reads the value when the user switches to it.
    /// </summary>
    [JSInvokable]
    public Task OnBodyHtmlChanged(string html)
    {
        if (_draft is not null) _draft.BodyHtml = html ?? string.Empty;
        return Task.CompletedTask;
    }

    // Leaving Design for Preview: flush the editor's current HTML into the draft
    // while the contenteditable is still in the DOM. Without this, a body change
    // still inside the input debounce would be dropped when OnAfterRenderAsync
    // tears the editor down for the Preview render.
    private async Task ShowPreviewAsync()
    {
        if (_editorInitialized && !_editorFailed && _draft is not null)
        {
            _draft.BodyHtml = await JS.InvokeAsync<string>("dueMapEditor.getHtml", BodyEditorId);
        }
        _htmlTab = HtmlTab.Preview;
    }

    // Push a programmatic content change (prefill / reset) into the live editor.
    // No-op when the editor isn't up yet (the open path seeds via init instead).
    private async Task SyncEditorAsync()
    {
        if (_editorInitialized && !_editorFailed && _draft is not null)
        {
            await JS.InvokeVoidAsync("dueMapEditor.setHtml", BodyEditorId, _draft.BodyHtml ?? string.Empty);
        }
    }

    /// <summary>
    /// Direct mode: open the modal for a specific notice type, fixed to the
    /// PM-generic override (state = null). Used by NoticePreferences where the
    /// user already knows which kind of notice they're editing.
    /// </summary>
    public async Task ShowAsync(string noticeTypeCode, string friendlyName)
    {
        await ResetStateAsync();
        _showPicker = false;
        _noticeTypeCode = noticeTypeCode;
        _friendlyName = friendlyName;

        var match = _noticeTypes.FirstOrDefault(t => t.Code == noticeTypeCode);
        if (match is null)
        {
            _hint = $"Unknown notice type '{noticeTypeCode}'. Configure it in the notice_types catalogue first.";
            _draft = new PmTemplateOverride { PropertyManagerId = PropertyManagerId, IsActive = true };
            _visible = true;
            return;
        }
        _noticeTypeId = match.Id;

        // Existing PM-generic override?
        var existing = (await Overrides.ListForPmAsync(PropertyManagerId, CancellationToken.None))
            .FirstOrDefault(o => o.IsActive && o.NoticeTypeId == _noticeTypeId && o.StateId is null);

        if (existing is not null)
        {
            HydrateFromExisting(existing);
            _hint = "Editing your existing customization. Click Reset to default to discard your changes and start from the system template.";
        }
        else
        {
            _draft = NewBlankDraft(_noticeTypeId, stateId: null);
            await PrefillFromDefaultAsync();
        }

        _visible = true;
        StateHasChanged();
    }

    /// <summary>
    /// Picker mode for editing an EXISTING override. Type + state are locked
    /// (you can't change which row this is); the form just shows the saved
    /// subject/body for tweaking. Used by the Templates page's row Edit button.
    /// </summary>
    public async Task ShowExistingAsync(PmTemplateOverride row)
    {
        await ResetStateAsync();
        _showPicker = true;
        HydrateFromExisting(row);
        _noticeTypeId = row.NoticeTypeId;
        _noticeTypeCode = _noticeTypes.FirstOrDefault(t => t.Id == row.NoticeTypeId)?.Code ?? string.Empty;
        _friendlyName = _noticeTypes.FirstOrDefault(t => t.Id == row.NoticeTypeId)?.DisplayName ?? "Override";
        _hint = "Editing your existing customization. Click Reset to default to discard your changes and start from the system template.";
        _visible = true;
        StateHasChanged();
    }

    /// <summary>
    /// Picker mode for creating a NEW override. Type + state dropdowns are
    /// editable; system defaults reload as the user picks each combination.
    /// Used by the Templates page's "New override" button.
    /// </summary>
    public async Task ShowNewWithPickerAsync()
    {
        await ResetStateAsync();
        _showPicker = true;

        var first = _noticeTypes.FirstOrDefault();
        _noticeTypeId = first?.Id ?? 0;
        _noticeTypeCode = first?.Code ?? string.Empty;
        _friendlyName = first?.DisplayName ?? "Override";

        _draft = NewBlankDraft(_noticeTypeId, stateId: null);
        await PrefillFromDefaultAsync();

        _visible = true;
        StateHasChanged();
    }

    // Resets all per-open transient state and loads the catalogues. Lookups are
    // memoised on the first call across opens to avoid hammering EF.
    private async Task ResetStateAsync()
    {
        _hint = null;
        _saving = false;
        _htmlTab = HtmlTab.Design;
        _themeKey = EmailThemes.DefaultKey;
        _focusedFieldId = BodyEditorId;

        // Re-opening for a different template without a close in between: drop the
        // old editor so OnAfterRenderAsync re-seeds it from the incoming draft.
        if (_editorInitialized)
        {
            try { await JS.InvokeVoidAsync("dueMapEditor.destroy", BodyEditorId); }
            catch (JSException) { /* circuit/teardown race — ignore */ }
            _editorInitialized = false;
        }

        if (_noticeTypes.Count == 0)
        {
            _noticeTypes = await NoticeTypeReader.ListAllAsync(CancellationToken.None);
        }
        if (_states.Count == 0)
        {
            _states = await StateReader.ListAllAsync(CancellationToken.None);
        }
    }

    private static PmTemplateOverride NewBlankDraft(int noticeTypeId, int? stateId) => new()
    {
        NoticeTypeId = noticeTypeId,
        StateId = stateId,
        Subject = string.Empty,
        BodyHtml = string.Empty,
        BodyText = string.Empty,
        IsActive = true
    };

    private void HydrateFromExisting(PmTemplateOverride row)
    {
        _draft = new PmTemplateOverride
        {
            Id = row.Id,
            PropertyManagerId = row.PropertyManagerId,
            NoticeTypeId = row.NoticeTypeId,
            StateId = row.StateId,
            Subject = row.Subject,
            BodyHtml = row.BodyHtml,
            BodyText = row.BodyText,
            IsActive = row.IsActive
        };
    }

    // Picker change handlers — used in _showPicker mode. When the user changes
    // the notice type or state, the form re-seeds with the matching system
    // default so they don't stare at a blank slate.
    private async Task OnNoticeTypeChangedAsync(ChangeEventArgs e)
    {
        if (_draft is null || _draft.Id != 0) return;
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            _draft.NoticeTypeId = id;
            _noticeTypeId = id;
            _noticeTypeCode = _noticeTypes.FirstOrDefault(t => t.Id == id)?.Code ?? string.Empty;
            _friendlyName = _noticeTypes.FirstOrDefault(t => t.Id == id)?.DisplayName ?? "Override";
        }
        await PrefillFromDefaultAsync();
        await SyncEditorAsync();
        StateHasChanged();
    }

    private async Task OnStateChangedAsync(ChangeEventArgs e)
    {
        if (_draft is null || _draft.Id != 0) return;
        _draft.StateId = int.TryParse(e.Value?.ToString(), out var sid) ? sid : (int?)null;
        await PrefillFromDefaultAsync();
        await SyncEditorAsync();
        StateHasChanged();
    }

    private async Task PrefillFromDefaultAsync()
    {
        if (_draft is null) return;
        var version = await TemplateResolver.ResolveActiveVersionAsync(
            _draft.StateId, _noticeTypeCode,
            DateOnly.FromDateTime(DateTime.UtcNow), CancellationToken.None);

        if (version is null)
        {
            _draft.Subject  = string.Empty;
            _draft.BodyHtml = string.Empty;
            _draft.BodyText = string.Empty;
            var stateLabel = _draft.StateId is int sid ? StateCode(sid) : "all states";
            _hint = $"No system default exists for {_friendlyName} ({stateLabel}). Starting from a blank slate.";
            return;
        }

        _draft.Subject  = version.Subject;
        _draft.BodyHtml = version.BodyHtml;
        _draft.BodyText = version.BodyText;

        var stateLabel2 = _draft.StateId is int sid2 ? StateCode(sid2) : "all states";
        _hint = $"Pre-filled from the system default ({stateLabel2}). Edit freely — required placeholders are still enforced on save.";
    }

    private string StateCode(int id) =>
        _states.FirstOrDefault(s => s.Id == id)?.Code ?? $"#{id}";

    private async Task ResetToDefaultAsync()
    {
        await PrefillFromDefaultAsync();
        await SyncEditorAsync();
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (_draft is null) return;
        // PropertyManagerId is the only field both NewBlank and HydrateFromExisting
        // can't reliably populate (NewBlank is static; Hydrate carries it through
        // from the source row but we belt-and-suspender it here). Setting it
        // unconditionally is a no-op when already correct.
        _draft.PropertyManagerId = PropertyManagerId;

        // Pull the latest body straight from the editor before saving — the
        // edit->C# round-trip is debounced, so a PM who types and immediately
        // clicks Save could otherwise persist a slightly stale draft.
        if (_editorInitialized && !_editorFailed)
        {
            _draft.BodyHtml = await JS.InvokeAsync<string>("dueMapEditor.getHtml", BodyEditorId);
        }

        // Rich HTML is the only thing the PM edits now; the plain-text body
        // (used for SMS + the email text part) is derived from it so the two
        // never drift. Merge fields ({{ }}, {% %}) survive untouched.
        _draft.BodyText = HtmlToPlainText(_draft.BodyHtml);

        _saving = true;
        try
        {
            await Overrides.UpsertAsync(_draft, CancellationToken.None);
            _visible = false;
            if (OnSaved.HasDelegate) await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private void Close()
    {
        _visible = false;
        _draft = null;
    }

    /// <summary>
    /// Derive a plain-text body from the rich HTML for the SMS + email text
    /// part. Anchors become "label: url" so the pay link survives in SMS;
    /// block-level tags become line breaks; everything else is stripped and
    /// HTML entities decoded. Scriban tags ({{ }} / {% %}) pass through so the
    /// text body still merges the lease's values at send time.
    /// </summary>
    private static string HtmlToPlainText(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return string.Empty;

        var s = html;
        // <a href="X">label</a> -> "label: X" (keep the URL for SMS).
        s = System.Text.RegularExpressions.Regex.Replace(
            s, @"<a\b[^>]*?href\s*=\s*[""']([^""']+)[""'][^>]*>(.*?)</a>",
            "$2: $1",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);
        // Block enders / line breaks -> newline.
        s = System.Text.RegularExpressions.Regex.Replace(
            s, @"<\s*(br|/p|/div|/li|/h[1-6]|/tr)\s*/?>", "\n",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        // Strip remaining tags.
        s = System.Text.RegularExpressions.Regex.Replace(s, @"<[^>]+>", string.Empty);
        // Decode entities (&amp; &nbsp; etc.).
        s = System.Net.WebUtility.HtmlDecode(s);
        // Collapse 3+ blank lines, trim trailing spaces per line.
        s = System.Text.RegularExpressions.Regex.Replace(s, @"[ \t]+\n", "\n");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\n{3,}", "\n\n");
        return s.Trim();
    }

    // Drops a placeholder token (asHtml: false) or a styled snippet (asHtml:
    // true) at the caret of whichever field the user last focused.
    //   * Body field with the live WYSIWYG -> the Medium Editor bridge, which
    //     inserts a text node or parsed markup and fires editableInput so the
    //     value syncs back to _draft.BodyHtml.
    //   * Subject input (or the textarea fallback) -> the plain dueMapTemplate
    //     helper, which mutates .value and dispatches `input` for @bind.
    private async Task InsertPlaceholderAsync(string content, bool asHtml)
    {
        var intoBodyEditor = _focusedFieldId == BodyEditorId && _editorInitialized && !_editorFailed;
        if (intoBodyEditor)
        {
            await JS.InvokeVoidAsync("dueMapEditor.insertAtCursor", BodyEditorId, content, asHtml);
        }
        else
        {
            await JS.InvokeVoidAsync("dueMapTemplate.insertAtCursor", _focusedFieldId, content);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_editorInitialized)
            {
                await JS.InvokeVoidAsync("dueMapEditor.destroy", BodyEditorId);
            }
        }
        catch (JSDisconnectedException) { /* circuit already torn down */ }
        catch (JSException) { /* best-effort cleanup */ }

        _dotNetRef?.Dispose();
    }
}
