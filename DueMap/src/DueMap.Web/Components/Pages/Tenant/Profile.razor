@page "/t/profile"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout DueMap.Web.Components.Layout.TenantLayout
@using DueMap.Tenancy
@using DueMap.Tenancy.Domain
@using DueMap.Tenancy.Services
@using DueMap.Web.Services
@inject TenantContext Tenant
@inject IPmCurrencyReader CurrencyReader
@inject ICustomerRepository Customers
@inject ILeaseReader Leases
@inject IPropertyManagerReader PmReader
@inject NavigationManager Nav

<PageTitle>Profile — Tenant portal</PageTitle>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 space-y-6">

    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Profile</h1>
        <p class="mt-1 text-sm text-muted">
            Your contact information and lease details. To request a change, use the link below.
        </p>
    </div>

    @if (_loading)
    {
        <p class="text-sm text-muted">Loading…</p>
    }
    else if (_session is null || _customer is null)
    {
        <p class="text-sm text-muted">Redirecting to sign-in…</p>
    }
    else
    {
        @* CONTACT *@
        <section class="rounded-2xl border border-line bg-surface shadow-sm overflow-hidden">
            <header class="px-6 py-4 border-b border-line">
                <div class="text-sm font-semibold">Contact</div>
            </header>
            <dl class="px-6 py-5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm">
                <div>
                    <dt class="text-xs uppercase tracking-wider font-medium text-muted mb-1">Name</dt>
                    <dd>@_customer.DisplayName</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wider font-medium text-muted mb-1">Email</dt>
                    <dd class="break-all">@(_customer.Email ?? "—")</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wider font-medium text-muted mb-1">Phone</dt>
                    <dd>@(_customer.Phone ?? "—")</dd>
                </div>
            </dl>
            <footer class="px-6 py-3 border-t border-line bg-surface-2 text-xs text-muted flex items-center justify-between gap-2 flex-wrap">
                <span>To update, ask your property manager.</span>
                @if (!string.IsNullOrEmpty(_pmContactMailto))
                {
                    <a href="@_pmContactMailto"
                       class="inline-flex items-center gap-1 px-2 py-1 rounded-md font-medium text-primary hover:bg-indigo-50 dark:hover:bg-primary-soft">
                        Request a change →
                    </a>
                }
            </footer>
        </section>

        @* LEASE *@
        @if (_lease is not null)
        {
            <section class="rounded-2xl border border-line bg-surface shadow-sm overflow-hidden">
                <header class="px-6 py-4 border-b border-line">
                    <div class="text-sm font-semibold">Lease</div>
                </header>
                <dl class="px-6 py-5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm">
                    <div>
                        <dt class="text-xs uppercase tracking-wider font-medium text-muted mb-1">Monthly rent</dt>
                        <dd class="tabular-nums">@_lease.MonthlyRent.ToString("C", _money)</dd>
                    </div>
                    <div>
                        <dt class="text-xs uppercase tracking-wider font-medium text-muted mb-1">Unit</dt>
                        <dd>@(_lease.UnitLabel ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-xs uppercase tracking-wider font-medium text-muted mb-1">Lease start</dt>
                        <dd class="tabular-nums">@_lease.StartDate.ToString("MMM d, yyyy")</dd>
                    </div>
                    <div>
                        <dt class="text-xs uppercase tracking-wider font-medium text-muted mb-1">Lease end</dt>
                        <dd class="tabular-nums">@(_lease.EndDate is DateOnly d ? d.ToString("MMM d, yyyy") : "Open-ended")</dd>
                    </div>
                </dl>
            </section>
        }

        @* SIGN-IN OPTIONS *@
        <section class="rounded-2xl border border-line bg-surface shadow-sm overflow-hidden">
            <header class="px-6 py-4 border-b border-line">
                <div class="text-sm font-semibold">Sign-in</div>
            </header>
            <div class="px-6 py-5 text-sm flex items-center justify-between gap-4 flex-wrap">
                <div>
                    <div class="font-medium">@(_session.HasPassword ? "Password is set" : "Magic link only")</div>
                    <p class="text-xs text-muted mt-1">
                        @(_session.HasPassword
                            ? "You can sign in with either your password or by requesting a magic link."
                            : "Each sign-in sends a one-time link to your email. Set a password if you'd prefer faster repeat sign-ins.")
                    </p>
                </div>
                <a href="/t/set-password"
                   class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm font-medium text-heading bg-surface border border-line hover:bg-surface-2">
                    @(_session.HasPassword ? "Change password" : "Set a password")
                </a>
            </div>
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private TenantSessionContext? _session;
    private Customer? _customer;
    private Lease? _lease;
    private string? _pmContactMailto;
    private System.Globalization.CultureInfo _money = MoneyCultures.Usd;

    protected override async Task OnInitializedAsync()
    {
        var ct = CancellationToken.None;
        _session = await Tenant.GetAsync(ct);
        if (_session is null)
        {
            Nav.NavigateTo("/t/login", replace: true);
            return;
        }

        // Amounts render in the PM's book currency — the tenant portal has no
        // signed-in PM circuit, so resolve directly from the session's PM id.
        _money = MoneyCultures.For(await CurrencyReader.GetCurrencyCodeAsync(_session.PropertyManagerId, ct));

        _customer = await Customers.GetByIdAsync(_session.CustomerId, ct);

        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var leases = await Leases.ListActiveAsync(_session.PropertyManagerId, today, ct);
        _lease = leases.FirstOrDefault(l => l.CustomerId == _session.CustomerId);

        // Pre-fill a mailto link to the PM. We don't have the PM's user email
        // directly (it lives on identity.users), so for v1 the mailto opens
        // an empty draft with a subject — the tenant fills in the To address
        // from prior correspondence. Wiring the actual PM email is a quick
        // follow-up once we expose it via a tenancy reader.
        var pm = await PmReader.GetAsync(_session.PropertyManagerId, ct);
        if (pm is not null)
        {
            var subject = Uri.EscapeDataString($"Request to update my contact info — {_customer?.DisplayName ?? "Tenant"}");
            _pmContactMailto = $"mailto:?subject={subject}";
        }

        _loading = false;
    }
}
