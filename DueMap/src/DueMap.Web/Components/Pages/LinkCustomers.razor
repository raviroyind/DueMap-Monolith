@page "/link-customers"
@using DueMap.Tenancy
@using DueMap.Tenancy.Domain
@using DueMap.Web.Services
@inject PmContext Pm
@inject ILeaseReader LeaseReader
@inject ICustomerRepository Customers
@inject ILeaseLinkService Linker
@inject DueMap.Common.FeatureFlags.IFeatureFlags Flags
@inject NavigationManager Nav

<PageTitle>Link customers — DueMap</PageTitle>

<div class="max-w-6xl mx-auto px-6 md:px-8 py-8 space-y-5">

    <div>
        <h2 class="page-title">Customer ↔ Lease mapping</h2>
        <p class="mt-1.5 text-sm text-muted leading-relaxed max-w-2xl">
            Each lease is billed to one customer. Auto-link handles the obvious cases (one active lease per customer); everything else lands here for you to map.
        </p>
    </div>

    @if (_loading)
    {
        <p class="text-muted">Loading…</p>
    }
    else
    {
        @if (_toast is not null)
        {
            <div class="alert alert-success">@_toast</div>
        }

        <!-- STATS BAR -->
        <div class="card flex flex-wrap items-center gap-6 px-5 py-3">
            <div class="flex items-center gap-2 text-sm">
                <span class="text-muted">Total leases</span>
                <span class="font-semibold tabular-nums text-heading">@_rows.Count</span>
            </div>
            <div class="w-px h-4 bg-line"></div>
            <div class="flex items-center gap-2 text-sm">
                <span class="text-muted">Linked</span>
                <span class="font-semibold tabular-nums text-success">@_rows.Count(r => r.CustomerId is not null)</span>
            </div>
            <div class="w-px h-4 bg-line"></div>
            <div class="flex items-center gap-2 text-sm">
                <span class="text-muted">Unmapped</span>
                <span class="font-semibold tabular-nums text-warning">@_rows.Count(r => r.CustomerId is null)</span>
            </div>
            <div class="w-px h-4 bg-line"></div>
            <div class="flex items-center gap-2 text-sm">
                <span class="text-muted">Customers synced</span>
                <span class="font-semibold tabular-nums text-heading">@_customers.Count</span>
            </div>
        </div>

        @if (_customers.Count == 0)
        {
            <div class="rounded-card border border-dashed border-line p-12 text-center">
                <div class="text-sm font-medium text-heading mb-1">No customers synced yet</div>
                <p class="text-sm text-muted max-w-sm mx-auto">
                    <a href="connections" class="font-medium text-primary">Connect QuickBooks or Xero</a>
                    and wait for the next daily sync.
                </p>
            </div>
        }
        else
        {
            <div class="card">
                <div class="overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Lease</th>
                                <th class="text-right">Rent</th>
                                <th>Start</th>
                                <th>Current customer</th>
                                <th>Reassign</th>
                                <th class="w-32"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _rows)
                            {
                                <tr>
                                    <td class="cell-strong tabular">#@r.LeaseId</td>
                                    <td class="text-right tabular">@r.MonthlyRent.ToString("C")</td>
                                    <td class="text-muted tabular">@r.StartDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (r.CustomerId is int cid)
                                        {
                                            <div class="flex items-center gap-2.5 max-w-xs">
                                                <div class="w-7 h-7 rounded-full bg-surface-2 flex items-center justify-center text-[10px] font-semibold text-muted shrink-0">@Initials(r.CustomerDisplayName)</div>
                                                <div class="min-w-0">
                                                    <div class="text-sm font-medium text-heading truncate">@r.CustomerDisplayName</div>
                                                    <div class="text-[11px] text-muted">#@cid</div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning"><span class="dot"></span>Unmapped</span>
                                        }
                                    </td>
                                    <td>
                                        <select @bind="_selection[r.LeaseId]" class="form-select max-w-xs h-9">
                                            <option value="0">— Select customer —</option>
                                            @foreach (var c in _customers)
                                            {
                                                <option value="@c.Id">@c.DisplayName (#@c.Id)</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="text-right">
                                        <div class="inline-flex gap-1">
                                            <button class="btn btn-sm btn-primary"
                                                    @onclick="@(() => Save(r.LeaseId))"
                                                    disabled="@(_busyLeaseId == r.LeaseId || !_selection.TryGetValue(r.LeaseId, out var s) || s == 0)">
                                                Link
                                            </button>
                                            @if (r.CustomerId is not null)
                                            {
                                                <button class="btn btn-sm btn-ghost"
                                                        @onclick="@(() => Unlink(r.LeaseId))"
                                                        disabled="@(_busyLeaseId == r.LeaseId)">
                                                    Unlink
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (_rows.Count == 0)
                            {
                                <tr><td colspan="6" class="px-6 py-12 text-center text-sm text-muted">No leases for this PM.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private int? _pmId;
    private IReadOnlyList<LeaseWithCustomer> _rows = Array.Empty<LeaseWithCustomer>();
    private IReadOnlyList<Customer> _customers = Array.Empty<Customer>();
    private readonly Dictionary<int, int> _selection = new();
    private bool _loading = true;
    private int? _busyLeaseId;
    private string? _toast;

    protected override async Task OnInitializedAsync()
    {
        _pmId = await Pm.GetPmIdAsync();
        // P1-5: superseded by the unified Tenants screen when the flag is on.
        if (await Flags.IsEnabledAsync("tenancy.tenants_screen", _pmId, CancellationToken.None))
        {
            Nav.NavigateTo("/tenants", replace: true);
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_pmId is not int id) return;
        _loading = true;
        _selection.Clear();
        StateHasChanged();
        _rows = await LeaseReader.ListWithCustomerAsync(id, CancellationToken.None);
        _customers = await Customers.ListByPropertyManagerAsync(id, CancellationToken.None);
        foreach (var r in _rows) _selection[r.LeaseId] = 0;
        _loading = false;
        StateHasChanged();
    }

    private async Task Save(int leaseId)
    {
        if (!_selection.TryGetValue(leaseId, out var customerId) || customerId == 0) return;
        _busyLeaseId = leaseId;
        try
        {
            await Linker.LinkCustomerAsync(leaseId, customerId, CancellationToken.None);
            _toast = $"Lease #{leaseId} linked to customer #{customerId}.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _toast = $"Link failed: {ex.Message}";
        }
        finally
        {
            _busyLeaseId = null;
        }
    }

    private async Task Unlink(int leaseId)
    {
        _busyLeaseId = leaseId;
        try
        {
            await Linker.LinkCustomerAsync(leaseId, null, CancellationToken.None);
            _toast = $"Lease #{leaseId} unlinked.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _toast = $"Unlink failed: {ex.Message}";
        }
        finally
        {
            _busyLeaseId = null;
        }
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "·";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "·";
        if (parts.Length == 1) return char.ToUpperInvariant(parts[0][0]).ToString();
        return string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[1][0]));
    }
}
