@page "/link-customers"
@using DueMap.Tenancy
@using DueMap.Tenancy.Domain
@using DueMap.Web.Services
@inject PmContext Pm
@inject ILeaseReader LeaseReader
@inject ICustomerRepository Customers
@inject ILeaseLinkService Linker

<PageTitle>Link customers — DueMap</PageTitle>

<div class="max-w-6xl mx-auto px-8 py-8 space-y-5">

    <div>
        <h2 class="text-2xl font-semibold tracking-tight">Customer ↔ Lease mapping</h2>
        <p class="mt-1.5 text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-2xl">
            Each lease is billed to one customer. Auto-link handles the obvious cases (one active lease per customer); everything else lands here for you to map.
        </p>
    </div>

    @if (_loading)
    {
        <p class="text-zinc-500">Loading…</p>
    }
    else
    {
        @if (_toast is not null)
        {
            <div class="rounded-xl border border-emerald-200/70 dark:border-emerald-500/20 bg-emerald-50/60 dark:bg-emerald-500/5 px-4 py-3 text-sm text-emerald-900 dark:text-emerald-200">@_toast</div>
        }

        <!-- STATS BAR -->
        <div class="flex flex-wrap items-center gap-6 px-5 py-3 rounded-xl border border-zinc-200/60 dark:border-zinc-800 bg-white dark:bg-zinc-900">
            <div class="flex items-center gap-2 text-sm">
                <span class="text-zinc-500">Total leases</span>
                <span class="font-semibold tabular-nums">@_rows.Count</span>
            </div>
            <div class="w-px h-4 bg-zinc-200 dark:bg-zinc-700"></div>
            <div class="flex items-center gap-2 text-sm">
                <span class="text-zinc-500">Linked</span>
                <span class="font-semibold tabular-nums text-emerald-700 dark:text-emerald-400">@_rows.Count(r => r.CustomerId is not null)</span>
            </div>
            <div class="w-px h-4 bg-zinc-200 dark:bg-zinc-700"></div>
            <div class="flex items-center gap-2 text-sm">
                <span class="text-zinc-500">Unmapped</span>
                <span class="font-semibold tabular-nums text-amber-700 dark:text-amber-400">@_rows.Count(r => r.CustomerId is null)</span>
            </div>
            <div class="w-px h-4 bg-zinc-200 dark:bg-zinc-700"></div>
            <div class="flex items-center gap-2 text-sm">
                <span class="text-zinc-500">Customers synced</span>
                <span class="font-semibold tabular-nums">@_customers.Count</span>
            </div>
        </div>

        @if (_customers.Count == 0)
        {
            <div class="rounded-xl border border-dashed border-zinc-300 dark:border-zinc-700 bg-white/40 dark:bg-zinc-900/40 p-12 text-center">
                <div class="text-sm font-medium mb-1">No customers synced yet</div>
                <p class="text-sm text-zinc-500 max-w-sm mx-auto">
                    <a href="connections" class="font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors">Connect QuickBooks or Xero</a>
                    and wait for the next daily sync.
                </p>
            </div>
        }
        else
        {
            <div class="rounded-xl border border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="bg-zinc-50/40 dark:bg-zinc-900/40">
                            <tr class="text-left">
                                <th class="px-4 py-2.5 text-[11px] font-medium uppercase tracking-wider text-zinc-500">Lease</th>
                                <th class="px-3 py-2.5 text-[11px] font-medium uppercase tracking-wider text-zinc-500 text-right">Rent</th>
                                <th class="px-3 py-2.5 text-[11px] font-medium uppercase tracking-wider text-zinc-500">Start</th>
                                <th class="px-3 py-2.5 text-[11px] font-medium uppercase tracking-wider text-zinc-500">Current customer</th>
                                <th class="px-3 py-2.5 text-[11px] font-medium uppercase tracking-wider text-zinc-500">Reassign</th>
                                <th class="w-32 px-4 py-2.5"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/60">
                            @foreach (var r in _rows)
                            {
                                var isUnmapped = r.CustomerId is null;
                                <tr class="@(isUnmapped ? "bg-amber-50/30 dark:bg-amber-500/[0.04] hover:bg-amber-50/60 dark:hover:bg-amber-500/[0.08]" : "hover:bg-zinc-50/60 dark:hover:bg-zinc-800/30") transition-colors duration-100">
                                    <td class="px-4 py-3 font-medium tabular-nums">#@r.LeaseId</td>
                                    <td class="px-3 py-3 text-right tabular-nums">@r.MonthlyRent.ToString("C")</td>
                                    <td class="px-3 py-3 text-xs text-zinc-500 tabular-nums">@r.StartDate.ToString("yyyy-MM-dd")</td>
                                    <td class="px-3 py-3">
                                        @if (r.CustomerId is int cid)
                                        {
                                            <div class="flex items-center gap-2.5 max-w-xs">
                                                <div class="w-7 h-7 rounded-full bg-zinc-200 dark:bg-zinc-700 flex items-center justify-center text-[10px] font-semibold text-zinc-600 dark:text-zinc-300 shrink-0">@Initials(r.CustomerDisplayName)</div>
                                                <div class="min-w-0">
                                                    <div class="text-sm font-medium truncate">@r.CustomerDisplayName</div>
                                                    <div class="text-[11px] text-zinc-500">#@cid</div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Unmapped
                                            </span>
                                        }
                                    </td>
                                    <td class="px-3 py-3">
                                        <select @bind="_selection[r.LeaseId]"
                                                class="w-full max-w-xs px-2.5 py-1.5 rounded-lg text-sm bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-shadow duration-150">
                                            <option value="0">— Select customer —</option>
                                            @foreach (var c in _customers)
                                            {
                                                <option value="@c.Id">@c.DisplayName (#@c.Id)</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <div class="inline-flex gap-1">
                                            <button class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition-colors duration-150 disabled:opacity-50 disabled:cursor-not-allowed"
                                                    @onclick="@(() => Save(r.LeaseId))"
                                                    disabled="@(_busyLeaseId == r.LeaseId || !_selection.TryGetValue(r.LeaseId, out var s) || s == 0)">
                                                Link
                                            </button>
                                            @if (r.CustomerId is not null)
                                            {
                                                <button class="inline-flex items-center px-2 py-1.5 rounded-md text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors disabled:opacity-50"
                                                        @onclick="@(() => Unlink(r.LeaseId))"
                                                        disabled="@(_busyLeaseId == r.LeaseId)">
                                                    Unlink
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (_rows.Count == 0)
                            {
                                <tr><td colspan="6" class="px-6 py-12 text-center text-sm text-zinc-500">No leases for this PM.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private int? _pmId;
    private IReadOnlyList<LeaseWithCustomer> _rows = Array.Empty<LeaseWithCustomer>();
    private IReadOnlyList<Customer> _customers = Array.Empty<Customer>();
    private readonly Dictionary<int, int> _selection = new();
    private bool _loading = true;
    private int? _busyLeaseId;
    private string? _toast;

    protected override async Task OnInitializedAsync()
    {
        _pmId = await Pm.GetPmIdAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_pmId is not int id) return;
        _loading = true;
        _selection.Clear();
        StateHasChanged();
        _rows = await LeaseReader.ListWithCustomerAsync(id, CancellationToken.None);
        _customers = await Customers.ListByPropertyManagerAsync(id, CancellationToken.None);
        foreach (var r in _rows) _selection[r.LeaseId] = 0;
        _loading = false;
        StateHasChanged();
    }

    private async Task Save(int leaseId)
    {
        if (!_selection.TryGetValue(leaseId, out var customerId) || customerId == 0) return;
        _busyLeaseId = leaseId;
        try
        {
            await Linker.LinkCustomerAsync(leaseId, customerId, CancellationToken.None);
            _toast = $"Lease #{leaseId} linked to customer #{customerId}.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _toast = $"Link failed: {ex.Message}";
        }
        finally
        {
            _busyLeaseId = null;
        }
    }

    private async Task Unlink(int leaseId)
    {
        _busyLeaseId = leaseId;
        try
        {
            await Linker.LinkCustomerAsync(leaseId, null, CancellationToken.None);
            _toast = $"Lease #{leaseId} unlinked.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _toast = $"Unlink failed: {ex.Message}";
        }
        finally
        {
            _busyLeaseId = null;
        }
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "·";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "·";
        if (parts.Length == 1) return char.ToUpperInvariant(parts[0][0]).ToString();
        return string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[1][0]));
    }
}
