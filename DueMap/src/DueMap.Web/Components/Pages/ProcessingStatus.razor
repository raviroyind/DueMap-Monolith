@page "/processing-status"
@using DueMap.Billing
@using DueMap.Billing.Domain
@using DueMap.Web.Services
@inject PmContext Pm
@inject PmClock Clock
@inject IPmProcessingRunRepository Runs

<PageTitle>Processing status — DueMap</PageTitle>

<div class="max-w-6xl mx-auto px-8 py-8 space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex items-end justify-between gap-4">
        <div>
            <h2 class="text-2xl font-semibold tracking-tight">Processing status</h2>
            <p class="mt-1.5 text-sm text-muted leading-relaxed max-w-2xl">
                Daily runs of the late-fee orchestrator. The sweep job ticks every 15 minutes; each run processes one PM's leases for the business date in their local time zone.
            </p>
        </div>
        <button class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium text-heading bg-surface border border-line hover:bg-surface-2 shadow-sm transition-colors duration-150"
                @onclick="LoadAsync">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
            Refresh
        </button>
    </div>

    @if (_loading)
    {
        <p class="text-muted">Loading…</p>
    }
    else if (_runs.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-line bg-white/40 dark:bg-[rgb(49_58_70/0.35)] p-12 text-center">
            <div class="text-sm font-medium mb-1">No runs yet</div>
            <p class="text-sm text-muted max-w-sm mx-auto">The orchestrator hasn't processed this PM. Trigger a run manually from the Hangfire dashboard or wait for the next 15-minute tick.</p>
        </div>
    }
    else
    {
        <section class="rounded-xl border border-line bg-surface shadow-sm overflow-hidden">
            <header class="px-6 py-4 border-b border-line flex items-center justify-between gap-3">
                <div>
                    <div class="text-sm font-semibold">Recent runs</div>
                    <div class="text-xs text-muted mt-0.5">Last @_runs.Count run@(_runs.Count == 1 ? "" : "s")</div>
                </div>
            </header>

            <ul class="divide-y divide-[color:var(--line)]">
                @foreach (var r in _runs)
                {
                    var (iconBg, iconColor, leftBorder) = StatusVisuals(r.Status);
                    <li class="@(string.IsNullOrEmpty(leftBorder) ? "" : $"border-l-2 {leftBorder}")">
                        <div class="px-6 py-4 flex items-start gap-4 hover:bg-zinc-50/40 dark:hover:bg-zinc-800/20 transition-colors">
                            <span class="inline-flex w-9 h-9 rounded-full @iconBg items-center justify-center @iconColor shrink-0 mt-0.5">
                                @if (r.Status == PmProcessingStatus.Completed)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
                                }
                                else if (r.Status == PmProcessingStatus.Failed)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                }
                            </span>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <div class="text-sm font-semibold">@r.BusinessDate.ToString("yyyy-MM-dd")</div>
                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium @StatusPillClass(r.Status)">
                                        <span class="w-1.5 h-1.5 rounded-full @StatusDotClass(r.Status)"></span>@r.Status
                                    </span>
                                </div>
                                <div class="mt-1 text-xs text-muted flex flex-wrap items-center gap-x-2.5 gap-y-1">
                                    <span><span class="tabular-nums">@r.LeasesPlanned</span> leases evaluated</span>
                                    <span class="w-1 h-1 rounded-full bg-line"></span>
                                    <span><span class="tabular-nums">@r.ActionsExecuted</span> actions</span>
                                    <span class="w-1 h-1 rounded-full bg-line"></span>
                                    <span class="tabular-nums">@FriendlyTime.Local(r.StartedAt, _zone)</span>
                                    @if (r.CompletedAt is not null)
                                    {
                                        <span class="w-1 h-1 rounded-full bg-line"></span>
                                        <span class="tabular-nums">finished @FriendlyTime.Local(r.CompletedAt.Value, _zone)</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(r.FailureReason))
                                {
                                    <div class="mt-2 rounded-lg border border-rose-200/60 dark:border-rose-500/15 bg-rose-50/40 dark:bg-rose-500/[0.06] px-3 py-2 flex items-start gap-2.5">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-rose-600 dark:text-rose-400 mt-0.5 shrink-0"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                                        <div class="text-xs text-rose-900 dark:text-rose-200 leading-relaxed">
                                            @Truncate(r.FailureReason, 200)
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    private int? _pmId;
    private IReadOnlyList<PmProcessingRun> _runs = Array.Empty<PmProcessingRun>();
    private bool _loading = true;

    // Workspace time zone — run timestamps render in the PM's local time.
    private TimeZoneInfo _zone = TimeZoneInfo.Utc;

    protected override async Task OnInitializedAsync()
    {
        _pmId = await Pm.GetPmIdAsync();
        _zone = await Clock.GetZoneAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_pmId is not int id) return;
        _loading = true;
        StateHasChanged();
        _runs = await Runs.ListRecentAsync(id, take: 30, CancellationToken.None);
        _loading = false;
        StateHasChanged();
    }

    private static (string IconBg, string IconColor, string LeftBorder) StatusVisuals(PmProcessingStatus s) => s switch
    {
        PmProcessingStatus.Completed => ("bg-emerald-50 dark:bg-emerald-500/10", "text-emerald-600 dark:text-emerald-400", "border-emerald-500/50"),
        PmProcessingStatus.Failed    => ("bg-rose-50 dark:bg-rose-500/10",       "text-rose-600 dark:text-rose-400",       "border-rose-500/60"),
        PmProcessingStatus.Started   => ("bg-amber-50 dark:bg-amber-500/10",     "text-amber-600 dark:text-amber-400",     "border-amber-500/50"),
        _ => ("bg-surface-2", "text-muted", "")
    };

    private static string StatusPillClass(PmProcessingStatus s) => s switch
    {
        PmProcessingStatus.Completed => "bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400",
        PmProcessingStatus.Failed    => "bg-rose-50 text-rose-700 dark:bg-rose-500/10 dark:text-rose-400",
        PmProcessingStatus.Started   => "bg-amber-50 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400",
        _ => "bg-zinc-100 text-body dark:bg-zinc-800 dark:text-muted"
    };

    private static string StatusDotClass(PmProcessingStatus s) => s switch
    {
        PmProcessingStatus.Completed => "bg-emerald-500",
        PmProcessingStatus.Failed    => "bg-rose-500",
        PmProcessingStatus.Started   => "bg-amber-500",
        _ => "bg-zinc-400"
    };

    private static string Truncate(string s, int n) => s.Length <= n ? s : s[..n] + "…";
}
