@page "/tenants"
@using System.Globalization
@using DueMap.Billing.Tenants
@using DueMap.Common.FeatureFlags
@using DueMap.Web.Services
@inject PmContext Pm
@inject PmMoney Money
@inject ToastService Toast
@inject ITenantsGridService Grid
@inject IFeatureFlags Flags

<PageTitle>Tenants — DueMap</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-5">

    <div>
        <h2 class="page-title">Tenants</h2>
        <p class="mt-1.5 text-sm text-muted max-w-3xl leading-relaxed">
            Every synced customer in one place. Set rent and state inline, link a customer to a lease,
            and see at a glance whether each fee is within state limits. This replaces the separate
            Leases and Link Customers screens.
        </p>
    </div>

    @if (_loading)
    {
        <p class="text-sm text-muted">Loading tenants…</p>
    }
    else if (_disabled)
    {
        <div class="alert alert-warning">
            <div>
                The unified Tenants screen is currently off. Set the
                <code class="font-mono text-xs">tenancy.tenants_screen</code> feature flag on to use it.
                In the meantime, use <a href="/leases" class="underline">Leases</a> and
                <a href="/link-customers" class="underline">Link customers</a>.
            </div>
        </div>
    }
    else
    {
        @* ---- filters + bulk bar ---- *@
        <div class="card p-4 space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="sm:col-span-2">
                    <label class="form-label">Search name or email</label>
                    <input type="search" placeholder="e.g. Cool Cars, jane@@example.com"
                           @bind="_search" @bind:event="oninput" @bind:after="OnFilterChanged"
                           class="form-control" />
                </div>
                <div>
                    <label class="form-label">Show</label>
                    <select @bind="_filter" @bind:after="OnFilterChanged" class="form-select">
                        <option value="all">All tenants</option>
                        <option value="linked">Linked to a lease</option>
                        <option value="unlinked">Not linked</option>
                        <option value="review">Needs review (fee risk)</option>
                    </select>
                </div>
            </div>

            @* bulk apply state across selected linked rows *@
            <div class="flex flex-wrap items-center gap-2 text-sm">
                <span class="text-muted">@_selected.Count selected</span>
                <span class="text-muted">·</span>
                <span class="text-muted">Set state for selected:</span>
                <select @bind="_bulkStateId" class="form-select h-9 w-auto">
                    <option value="0">— choose —</option>
                    @foreach (var s in _states)
                    {
                        <option value="@s.Id">@s.Code</option>
                    }
                </select>
                <button @onclick="ApplyBulkStateAsync" disabled="@(_selected.Count == 0 || _bulkStateId == 0 || _busy)"
                        class="btn btn-sm btn-primary">
                    Apply to @_selected.Count
                </button>
                <span class="text-muted ml-auto">@_rows.Count tenants · @LinkedCount linked</span>
            </div>
        </div>

        <div class="card">
            <div class="overflow-x-auto">
            <table class="table">
                <thead>
                    <tr>
                        <th class="w-10"></th>
                        <th>Customer</th>
                        <th class="w-20">State</th>
                        <th class="w-32">Rent</th>
                        <th class="w-24">Late fee</th>
                        <th class="w-28">Fee risk</th>
                        <th class="w-24">Reminders</th>
                        <th class="w-24">Autopay</th>
                        <th class="w-40 text-right">Lease</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pageRows.Count == 0)
                    {
                        <tr><td colspan="9" class="px-4 py-10 text-center text-sm text-muted">No tenants match these filters.</td></tr>
                    }
                    @foreach (var r in _pageRows)
                    {
                        var editing = _editingCustomerId == r.CustomerId;
                        <tr class="align-top">
                            <td>
                                <input type="checkbox" class="checkbox" disabled="@(r.LeaseId is null)"
                                       checked="@_selected.Contains(r.CustomerId)"
                                       @onchange="@(e => ToggleOne(r.CustomerId, (bool)e.Value!))" />
                            </td>
                            <td>
                                <div class="cell-strong">@r.CustomerName</div>
                                <div class="text-xs text-muted">@(string.IsNullOrWhiteSpace(r.Email) ? "no email" : r.Email)</div>
                            </td>

                            @if (editing)
                            {
                                <td>
                                    <select @bind="_editStateId" class="form-select h-8 text-xs">
                                        @foreach (var s in _states)
                                        {
                                            <option value="@s.Id">@s.Code</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0" @bind="_editRent" class="form-control h-8 text-xs" />
                                </td>
                                <td class="text-xs text-muted" colspan="4">
                                    Editing — save to update rent &amp; state.
                                </td>
                                <td class="text-right whitespace-nowrap">
                                    <button @onclick="SaveEditAsync" disabled="@_busy" class="@(_busy ? "is-loading" : "") btn btn-sm btn-primary">Save</button>
                                    <button @onclick="CancelEdit" class="btn btn-sm btn-link">Cancel</button>
                                </td>
                            }
                            else
                            {
                                <td>
                                    @if (r.StateCode is not null)
                                    {
                                        <span class="inline-flex px-1.5 py-0.5 rounded bg-surface-2 text-xs font-mono">@r.StateCode</span>
                                    }
                                    else { <span class="text-muted text-xs">—</span> }
                                </td>
                                <td class="tabular">
                                    @(r.MonthlyRent is decimal rent ? rent.ToString("C0", _money) : "—")
                                </td>
                                <td class="tabular">
                                    @(r.LateFeePercent is decimal p ? $"{p.ToString("0.##", CultureInfo.InvariantCulture)}%" : "—")
                                </td>
                                <td>
                                    <span class="badge @RiskClass(r.FeeRisk)">@RiskLabel(r.FeeRisk)</span>
                                </td>
                                <td class="text-xs">@(r.RemindersEnabled ? "On" : "—")</td>
                                <td class="text-xs text-muted">@r.AutopayStatus</td>
                                <td class="text-right whitespace-nowrap">
                                    @if (r.LeaseId is not null)
                                    {
                                        @if (r.FeesStaged)
                                        {
                                            <span class="badge badge-warning mr-1">staged</span>
                                        }
                                        <button @onclick="@(() => BeginEdit(r))" class="btn btn-sm btn-link">Edit</button>
                                    }
                                    else
                                    {
                                        <button @onclick="@(() => BeginCreate(r))" class="btn btn-sm btn-link text-warning">Create lease</button>
                                    }
                                </td>
                            }
                        </tr>

                        @if (_creatingCustomerId == r.CustomerId)
                        {
                            <tr class="bg-primary-soft">
                                <td></td>
                                <td colspan="8" class="px-3 py-3">
                                    <div class="flex flex-wrap items-end gap-3">
                                        <div>
                                            <label class="block text-[11px] text-muted mb-1">State</label>
                                            <select @bind="_editStateId" class="form-select h-9 w-auto">
                                                @foreach (var s in _states)
                                                {
                                                    <option value="@s.Id">@s.Code — @s.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-[11px] text-muted mb-1">Monthly rent</label>
                                            <input type="number" step="0.01" min="0" @bind="_editRent" class="form-control w-32 h-9" />
                                        </div>
                                        <button @onclick="SaveCreateAsync" disabled="@_busy" class="@(_busy ? "is-loading" : "") btn btn-sm btn-primary">Create &amp; link</button>
                                        <button @onclick="CancelEdit" class="btn btn-sm btn-link">Cancel</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            </div>

            <div class="px-4 py-3 border-t border-line flex items-center justify-between text-xs text-muted">
                <div>Page @(_page + 1) of @TotalPages</div>
                <div class="flex items-center gap-2">
                    <button @onclick="PrevPage" disabled="@(_page == 0)" class="btn btn-sm btn-secondary">Prev</button>
                    <button @onclick="NextPage" disabled="@(_page >= TotalPages - 1)" class="btn btn-sm btn-secondary">Next</button>
                </div>
            </div>
        </div>

    }
</div>

@code {
    private int _pmId;
    private bool _loading = true;
    private bool _disabled;
    private bool _busy;

    private List<TenantRow> _rows = new();
    private List<TenantRow> _filtered = new();
    private List<TenantRow> _pageRows = new();
    private IReadOnlyList<(int Id, string Code, string Name)> _states = Array.Empty<(int, string, string)>();
    private readonly HashSet<int> _selected = new();

    private string _search = string.Empty;
    private string _filter = "all";
    private int _bulkStateId;

    private const int PageSize = 25;
    private int _page;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
    private int LinkedCount => _rows.Count(r => r.LeaseId is not null);

    // inline edit/create state
    private int? _editingCustomerId;
    private int? _creatingCustomerId;
    private int? _editLeaseId;
    private decimal _editRent;
    private int _editStateId;

    // PM-book currency for every amount on the page (never host locale).
    private CultureInfo _money = MoneyCultures.Usd;

    protected override async Task OnInitializedAsync()
    {
        _pmId = await Pm.GetPmIdAsync();
        _money = await Money.GetCultureAsync();
        _disabled = !await Flags.IsEnabledAsync("tenancy.tenants_screen", _pmId, CancellationToken.None);
        if (!_disabled)
        {
            _states = await Grid.GetStatesAsync(CancellationToken.None);
            await ReloadAsync();
        }
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _rows = (await Grid.GetRowsAsync(_pmId, CancellationToken.None))
            .OrderBy(r => r.CustomerName, StringComparer.OrdinalIgnoreCase).ToList();
        ApplyFilters();
    }

    private void OnFilterChanged() { _page = 0; ApplyFilters(); }

    private void ApplyFilters()
    {
        IEnumerable<TenantRow> q = _rows;
        q = _filter switch
        {
            "linked"   => q.Where(r => r.LeaseId is not null),
            "unlinked" => q.Where(r => r.LeaseId is null),
            "review"   => q.Where(r => r.FeeRisk is FeeRisk.OverCap or FeeRisk.Review),
            _          => q
        };
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var n = _search.Trim();
            q = q.Where(r => r.CustomerName.Contains(n, StringComparison.OrdinalIgnoreCase)
                          || (r.Email != null && r.Email.Contains(n, StringComparison.OrdinalIgnoreCase)));
        }
        _filtered = q.ToList();
        if (_page >= TotalPages) _page = TotalPages - 1;
        if (_page < 0) _page = 0;
        SlicePage();
    }

    private void SlicePage() => _pageRows = _filtered.Skip(_page * PageSize).Take(PageSize).ToList();
    private void PrevPage() { if (_page > 0) { _page--; SlicePage(); } }
    private void NextPage() { if (_page < TotalPages - 1) { _page++; SlicePage(); } }

    private void ToggleOne(int customerId, bool on)
    {
        if (on) _selected.Add(customerId); else _selected.Remove(customerId);
    }

    private void BeginEdit(TenantRow r)
    {
        _editingCustomerId = r.CustomerId;
        _creatingCustomerId = null;
        _editLeaseId = r.LeaseId;
        _editRent = r.MonthlyRent ?? 0m;
        _editStateId = r.StateId ?? (_states.Count > 0 ? _states[0].Id : 0);
    }

    private void BeginCreate(TenantRow r)
    {
        _creatingCustomerId = r.CustomerId;
        _editingCustomerId = null;
        _editRent = 0m;
        // Prefer the customer's billing state if it maps to a known state code.
        var match = _states.FirstOrDefault(s => string.Equals(s.Code, r.BillingState, StringComparison.OrdinalIgnoreCase));
        _editStateId = match.Id != 0 ? match.Id : (_states.Count > 0 ? _states[0].Id : 0);
    }

    private void CancelEdit() { _editingCustomerId = null; _creatingCustomerId = null; }

    private async Task SaveEditAsync()
    {
        if (_editLeaseId is not int leaseId) return;
        await RunAsync(async () =>
        {
            await Grid.UpdateLeaseAsync(leaseId, _editRent, _editStateId, CancellationToken.None);
            return "Lease updated.";
        });
    }

    private async Task SaveCreateAsync()
    {
        if (_creatingCustomerId is not int customerId) return;
        await RunAsync(async () =>
        {
            await Grid.CreateLeaseForCustomerAsync(_pmId, customerId, _editStateId, _editRent, CancellationToken.None);
            return "Lease created and linked.";
        });
    }

    private async Task ApplyBulkStateAsync()
    {
        if (_bulkStateId == 0 || _selected.Count == 0) return;
        await RunAsync(async () =>
        {
            var targets = _rows.Where(r => _selected.Contains(r.CustomerId) && r.LeaseId is int && r.MonthlyRent is decimal).ToList();
            foreach (var r in targets)
            {
                await Grid.UpdateLeaseAsync(r.LeaseId!.Value, r.MonthlyRent!.Value, _bulkStateId, CancellationToken.None);
            }
            _selected.Clear();
            _bulkStateId = 0;
            return $"Applied state to {targets.Count} lease(s).";
        });
    }

    // Shared run wrapper: guards re-entrancy, validates rent, reloads, toasts the result.
    private async Task RunAsync(Func<Task<string>> action)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            if ((_editingCustomerId is not null || _creatingCustomerId is not null) && _editRent <= 0m)
            {
                Toast.Error("Rent must be greater than zero.");
                return;
            }
            var ok = await action();
            _editingCustomerId = null;
            _creatingCustomerId = null;
            await ReloadAsync();
            Toast.Success(ok);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string RiskLabel(FeeRisk r) => r switch
    {
        FeeRisk.Ok => "OK",
        FeeRisk.Review => "Review",
        FeeRisk.OverCap => "Over cap",
        _ => "—"
    };

    // Osen badge family for the fee-risk pill.
    private static string RiskClass(FeeRisk r) => r switch
    {
        FeeRisk.Ok      => "badge-success",
        FeeRisk.Review  => "badge-warning",
        FeeRisk.OverCap => "badge-danger",
        _               => "badge-neutral"
    };
}
