@page "/notice-preferences"
@using DueMap.Tenancy
@using DueMap.Tenancy.Domain
@using DueMap.Web.Components.Shared
@using DueMap.Web.Services
@inject PmContext Pm
@inject IPmNoticePreferencesService Prefs

<PageTitle>Notice preferences — DueMap</PageTitle>

<div class="max-w-3xl mx-auto px-6 md:px-8 py-8 pb-32 space-y-6">

    <div>
        <h2 class="page-title">Notice preferences</h2>
        <p class="mt-1.5 text-sm text-muted leading-relaxed">
            Master toggles and defaults that apply across your portfolio. Override per lease on the
            <a href="leases" class="font-medium text-primary">Leases page</a>.
            When a master is off, no notice of that kind goes out, period — per-lease settings can't override.
        </p>
    </div>

    @if (_pmId is null || _model is null)
    {
        <p class="text-muted">Loading…</p>
    }
    else
    {
        @if (_savedAt is not null)
        {
            <div class="alert alert-success">
                <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                <div class="flex-1 min-w-0">
                    <div class="alert-title">Saved</div>
                    <div class="text-xs mt-0.5">@_savedAt.Value.ToString("HH:mm:ss")</div>
                </div>
            </div>
        }

        <!-- PRE-DUE -->
        <section class="card" data-disabled="@((!_model.PreDueMasterEnabled).ToString().ToLowerInvariant())">
            <header class="card-header flex items-start justify-between gap-4">
                <div class="flex items-start gap-3 min-w-0">
                    <div class="w-9 h-9 rounded-field bg-primary-soft text-primary-soft-fg flex items-center justify-center shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/><path d="M4 2C2.8 3.7 2 5.7 2 8"/><path d="M22 8c0-2.3-.8-4.3-2-6"/></svg>
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-base font-semibold text-heading">Pre-due reminder</h3>
                        <p class="text-sm text-muted mt-0.5">A friendly nudge before the rent due date.</p>
                    </div>
                </div>
                <label class="form-switch shrink-0">
                    <input type="checkbox" @bind="_model.PreDueMasterEnabled" aria-label="Master enable" />
                    <span class="track"></span><span class="thumb"></span>
                </label>
            </header>
            <div class="pref-body">
                <div class="px-6 py-5 border-b border-line flex items-start justify-between gap-6">
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-medium text-heading">Days before due date</div>
                        <p class="text-xs text-muted mt-0.5">Tenants receive the reminder this many calendar days before rent is due.</p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <input type="number" min="1" max="60" @bind="_model.PreDueDefaultDaysBefore"
                               class="form-control w-20 text-right tabular" />
                        <span class="text-sm text-muted">days</span>
                    </div>
                </div>
                <div class="px-6 py-4 flex items-center justify-between gap-6">
                    <div class="flex items-center gap-3 flex-1 min-w-0">
                        <div class="w-7 h-7 rounded-md bg-surface-2 text-muted flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        </div>
                        <div class="min-w-0">
                            <div class="text-sm font-medium text-heading">Email template</div>
                            <p class="text-xs text-muted mt-0.5 truncate">Pre-due reminder</p>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-secondary shrink-0"
                            @onclick="@(() => OpenTemplateAsync("pre_due_reminder", "Pre-due reminder"))">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>
                        Edit template
                    </button>
                </div>
            </div>
        </section>

        <!-- DUE-DATE -->
        <section class="card" data-disabled="@((!_model.DueDateMasterEnabled).ToString().ToLowerInvariant())">
            <header class="card-header flex items-start justify-between gap-4">
                <div class="flex items-start gap-3 min-w-0">
                    <div class="w-9 h-9 rounded-field bg-primary-soft text-primary-soft-fg flex items-center justify-center shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h5"/><path d="M17.5 17.5 16 16.3V14"/><circle cx="16" cy="16" r="6"/></svg>
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-base font-semibold text-heading">Due-date reminder</h3>
                        <p class="text-sm text-muted mt-0.5">Sent on the day rent is due.</p>
                    </div>
                </div>
                <label class="form-switch shrink-0">
                    <input type="checkbox" @bind="_model.DueDateMasterEnabled" aria-label="Master enable" />
                    <span class="track"></span><span class="thumb"></span>
                </label>
            </header>
            <div class="pref-body">
                <div class="px-6 py-5 border-b border-line">
                    <p class="text-xs text-muted">When enabled, a reminder is sent the morning rent is due. No additional settings.</p>
                </div>
                <div class="px-6 py-4 flex items-center justify-between gap-6">
                    <div class="flex items-center gap-3 flex-1 min-w-0">
                        <div class="w-7 h-7 rounded-md bg-surface-2 text-muted flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        </div>
                        <div class="min-w-0">
                            <div class="text-sm font-medium text-heading">Email template</div>
                            <p class="text-xs text-muted mt-0.5 truncate">Due-date reminder</p>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-secondary shrink-0"
                            @onclick="@(() => OpenTemplateAsync("due_date_reminder", "Due-date reminder"))">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>
                        Edit template
                    </button>
                </div>
            </div>
        </section>

        <!-- POST-DUE -->
        <section class="card" data-disabled="@((!_model.PostDueMasterEnabled).ToString().ToLowerInvariant())">
            <header class="card-header flex items-start justify-between gap-4">
                <div class="flex items-start gap-3 min-w-0">
                    <div class="w-9 h-9 rounded-field bg-primary-soft text-primary-soft-fg flex items-center justify-center shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M12 12v3"/><path d="M12 18h.01"/></svg>
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-base font-semibold text-heading">Post-due handling</h3>
                        <p class="text-sm text-muted mt-0.5">What happens when rent isn't paid on time.</p>
                    </div>
                </div>
                <label class="form-switch shrink-0">
                    <input type="checkbox" @bind="_model.PostDueMasterEnabled" aria-label="Master enable" />
                    <span class="track"></span><span class="thumb"></span>
                </label>
            </header>
            <div class="pref-body">
                <div class="px-6 py-5 space-y-5 border-b border-line">
                    <div>
                        <div class="text-sm font-medium text-heading mb-2">Mode</div>
                        <select @bind="_model.PostDueDefaultMode" class="form-select max-w-sm">
                            <option value="@PostDueMode.GracePeriod">Grace period (reminder + later late fee)</option>
                            <option value="@PostDueMode.ImmediateLateFee">Immediate late fee (no grace reminder)</option>
                        </select>
                    </div>

                    <div>
                        <div class="flex items-start justify-between gap-6">
                            <div class="flex-1 min-w-0">
                                <div class="text-sm font-medium text-heading">Grace period</div>
                                <p class="text-xs text-muted mt-0.5">Days the tenant has to pay before a late fee is assessed.</p>
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                <input type="number" min="0" max="60" @bind="_model.PostDueDefaultGraceDays"
                                       class="form-control w-20 text-right tabular" />
                                <span class="text-sm text-muted">days</span>
                            </div>
                        </div>
                        <div class="alert alert-warning mt-3">
                            <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
                            <div class="leading-relaxed">
                                State law sets a minimum grace period for each lease. If your value is lower, DueMap automatically uses the state's minimum.
                            </div>
                        </div>
                    </div>
                </div>

                @* Grace reminder template (only shown when mode = GracePeriod) *@
                @if (_model.PostDueDefaultMode == PostDueMode.GracePeriod)
                {
                    <div class="px-6 py-4 border-b border-line flex items-center justify-between gap-6">
                        <div class="flex items-center gap-3 flex-1 min-w-0">
                            <div class="w-7 h-7 rounded-md bg-surface-2 text-muted flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                            </div>
                            <div class="min-w-0">
                                <div class="text-sm font-medium text-heading">Grace reminder template</div>
                                <p class="text-xs text-muted mt-0.5 truncate">Sent the morning after the due date</p>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-secondary shrink-0"
                                @onclick="@(() => OpenTemplateAsync("grace_period_reminder", "Grace-period reminder"))">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>
                            Edit template
                        </button>
                    </div>
                }

                @* Late-fee notice template (always shown) *@
                <div class="px-6 py-4 flex items-center justify-between gap-6">
                    <div class="flex items-center gap-3 flex-1 min-w-0">
                        <div class="w-7 h-7 rounded-md bg-surface-2 text-muted flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        </div>
                        <div class="min-w-0">
                            <div class="text-sm font-medium text-heading">Late-fee notice template</div>
                            <p class="text-xs text-muted mt-0.5 truncate">Sent when a late fee is assessed</p>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-secondary shrink-0"
                            @onclick="@(() => OpenTemplateAsync("late_fee_notice", "Late-fee notice"))">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>
                        Edit template
                    </button>
                </div>
            </div>
        </section>

        <!-- ACTIONS -->
        <div class="flex items-center justify-end gap-2 pt-2">
            <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                @(_saving ? "Saving…" : "Save preferences")
            </button>
        </div>
    }
</div>

@* Shared modal — one instance, four entry points. Mounted at page root so it
   overlays the entire viewport regardless of which card the user clicked from. *@
@if (_pmId is int pmId)
{
    <EditTemplateModal @ref="_templateModal" PropertyManagerId="pmId" />
}

@code {
    private int? _pmId;
    private PmNoticePreferences? _model;
    private bool _saving;
    private DateTime? _savedAt;
    private EditTemplateModal? _templateModal;

    protected override async Task OnInitializedAsync()
    {
        _pmId = await Pm.GetPmIdAsync();
        _model = await Prefs.GetOrCreateAsync(_pmId.Value, CancellationToken.None);
    }

    private async Task Save()
    {
        if (_model is null) return;
        _saving = true;
        try
        {
            _model = await Prefs.UpdateAsync(_model, CancellationToken.None);
            _savedAt = DateTime.UtcNow;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OpenTemplateAsync(string noticeTypeCode, string friendlyName)
    {
        if (_templateModal is null) return;
        await _templateModal.ShowAsync(noticeTypeCode, friendlyName);
    }
}
