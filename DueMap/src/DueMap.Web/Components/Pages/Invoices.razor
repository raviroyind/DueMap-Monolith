@page "/invoices"
@using DueMap.Tenancy
@using DueMap.Tenancy.Domain
@using DueMap.Web.Services
@inject PmContext Pm
@inject PmMoney Money
@inject IRentInvoiceRepository InvoiceRepo
@inject ICustomerRepository Customers

<PageTitle>Invoices — DueMap</PageTitle>

<div class="max-w-7xl mx-auto px-6 md:px-8 py-8 space-y-5">

    <div>
        <h2 class="page-title">Invoices</h2>
        <p class="mt-1.5 text-sm text-muted leading-relaxed max-w-2xl">
            Synced from your accounting provider on the daily sweep. Open rows drive the next reminder; overdue rows are candidates for late-fee assessment per your <a href="notice-preferences" class="font-medium text-primary">notice preferences</a>.
        </p>
    </div>

    @if (_loading)
    {
        <p class="text-muted">Loading…</p>
    }
    else
    {
        @* Search + filter strip. Search runs on every keystroke; filter chips
           swap categories. Both inputs participate in the same derivation
           pipeline so counts update live as the user types. *@
        <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex-1 min-w-[280px] max-w-md">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none z-10"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="search" placeholder="Search customer name or invoice #"
                       @bind="_search" @bind:event="oninput" @bind:after="() => _page = 0"
                       class="form-control pl-9" />
            </div>
            <div class="flex items-center gap-1.5 flex-wrap">
                @foreach (var f in _filters)
                {
                    var active = _activeFilter == f.Key;
                    <button type="button" @onclick="@(() => SelectFilter(f.Key))"
                            class="@(active ? "btn btn-sm btn-primary" : "btn btn-sm btn-secondary")">
                        @f.Label
                        <span class="text-[11px] tabular-nums opacity-80">@CountFor(f.Key)</span>
                    </button>
                }
            </div>
        </div>

        @if (_displayed.Count == 0)
        {
            <div class="rounded-card border border-dashed border-line p-12 text-center">
                <p class="text-sm font-medium text-heading mb-1">
                    @if (!string.IsNullOrEmpty(_search)) { @($"No invoices match \"{_search}\".") }
                    else { @("No invoices match this filter.") }
                </p>
                <p class="text-sm text-muted">Clear the filter or wait for the next sync to pull fresh data.</p>
            </div>
        }
        else
        {
            <div class="card">
                <div class="overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                @SortTh("Invoice #",  SortColumn.InvoiceNumber, "px-6 py-3", false)
                                @SortTh("Customer",   SortColumn.Customer,      "px-3 py-3", false)
                                @SortTh("Due",        SortColumn.DueDate,       "px-3 py-3", false)
                                @SortTh("Amount",     SortColumn.Amount,        "px-3 py-3", true)
                                @SortTh("Balance",    SortColumn.Balance,       "px-3 py-3", true)
                                @SortTh("Status",     SortColumn.Status,        "px-3 py-3", false)
                                @SortTh("Lease",      SortColumn.Lease,         "px-6 py-3", false)
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in _displayed)
                            {
                                <tr>
                                    <td class="px-6 cell-strong font-mono text-xs">@(inv.ExternalDocNumber ?? $"#{inv.Id}")</td>
                                    <td class="px-3 cell-strong">@CustomerName(inv.CustomerId)</td>
                                    <td class="px-3 text-muted tabular">@inv.DueDate.ToString("yyyy-MM-dd")</td>
                                    <td class="px-3 text-right tabular">@inv.TotalAmount.ToString("C", _money)</td>
                                    <td class="px-3 text-right tabular cell-strong">@inv.Balance.ToString("C", _money)</td>
                                    <td class="px-3">
                                        <span class="badge @StatusBadge(inv)"><span class="dot"></span>@StatusLabel(inv)</span>
                                    </td>
                                    <td class="px-6 text-xs">
                                        @if (inv.LeaseId is int leaseId)
                                        {
                                            <a href="@($"/leases/{leaseId}")" class="text-primary tabular">L-@leaseId</a>
                                        }
                                        else
                                        {
                                            <a href="link-customers" class="text-warning">unlinked</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pager Page="_page" PageSize="PageSize" TotalItems="_matched.Count"
                       ItemNoun="invoice" PageChanged="OnPageChanged" />
            </div>
        }
    }
</div>

@* Inline render fragment for sortable column headers. Cleaner than a nested
   component (Razor doesn't support those) and keeps the table head readable. *@
@code {
    private enum SortColumn { InvoiceNumber, Customer, DueDate, Amount, Balance, Status, Lease }
    private enum SortDirection { Asc, Desc }

    private RenderFragment SortTh(string label, SortColumn col, string padding, bool alignRight) => builder =>
    {
        var active = _sortColumn == col;
        var alignClass = alignRight ? "text-right" : "text-left";
        var span = alignRight ? "inline-flex items-center gap-1 justify-end w-full" : "inline-flex items-center gap-1";

        builder.OpenElement(0, "th");
        builder.AddAttribute(1, "class",
            $"{padding} cursor-pointer select-none hover:text-heading transition-colors {alignClass}");
        builder.AddAttribute(2, "onclick",
            Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => ToggleSort(col)));

        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "class", span);
        builder.AddContent(5, label);

        if (active)
        {
            builder.OpenElement(6, "svg");
            builder.AddAttribute(7, "xmlns", "http://www.w3.org/2000/svg");
            builder.AddAttribute(8, "width", "10");
            builder.AddAttribute(9, "height", "10");
            builder.AddAttribute(10, "viewBox", "0 0 24 24");
            builder.AddAttribute(11, "fill", "none");
            builder.AddAttribute(12, "stroke", "currentColor");
            builder.AddAttribute(13, "stroke-width", "3");
            builder.AddAttribute(14, "stroke-linecap", "round");
            builder.AddAttribute(15, "stroke-linejoin", "round");
            builder.AddAttribute(16, "class", "text-primary");
            builder.OpenElement(17, "path");
            builder.AddAttribute(18, "d", _sortDirection == SortDirection.Asc ? "m18 15-6-6-6 6" : "m6 9 6 6 6-6");
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement(); // span
        builder.CloseElement(); // th
    };
}

@code {
    private int? _pmId;
    private bool _loading = true;
    private IReadOnlyList<RentInvoice> _all = Array.Empty<RentInvoice>();
    private Dictionary<int, string> _customerNames = new();

    private enum FilterKey { All, Open, Overdue, Paid, Unlinked }
    private FilterKey _activeFilter = FilterKey.All;
    private string _search = string.Empty;
    private SortColumn _sortColumn = SortColumn.DueDate;
    private SortDirection _sortDirection = SortDirection.Desc;

    private sealed record Filter(FilterKey Key, string Label);
    private readonly Filter[] _filters =
    {
        new(FilterKey.All,      "All"),
        new(FilterKey.Open,     "Open"),
        new(FilterKey.Overdue,  "Overdue"),
        new(FilterKey.Paid,     "Paid"),
        new(FilterKey.Unlinked, "Unlinked")
    };

    // Derivation pipeline: filter → search → sort. Recomputed every render
    // (cheap for hundreds of rows; revisit if PMs cross 10k invoices).
    private List<RentInvoice> _matched => SortRows(SearchRows(FilterRows(_all)));

    // --- paging ------------------------------------------------------------
    private const int PageSize = 25;
    private int _page;

    /// <summary>Page slice; clamped so shrinking the result set can't strand
    /// the user past the last page.</summary>
    private List<RentInvoice> _displayed
    {
        get
        {
            var rows = _matched;
            var maxPage = Math.Max(0, (int)Math.Ceiling(rows.Count / (double)PageSize) - 1);
            if (_page > maxPage) _page = maxPage;
            return rows.Skip(_page * PageSize).Take(PageSize).ToList();
        }
    }

    private void OnPageChanged(int page) => _page = page;

    // PM-book currency for every amount on the page (never host locale).
    private System.Globalization.CultureInfo _money = MoneyCultures.Usd;

    protected override async Task OnInitializedAsync()
    {
        _pmId = await Pm.GetPmIdAsync();
        var ct = CancellationToken.None;
        _money = await Money.GetCultureAsync(ct);

        _all = await InvoiceRepo.ListByPropertyManagerAsync(_pmId.Value, ct);
        var customers = await Customers.ListByPropertyManagerAsync(_pmId.Value, ct);
        _customerNames = customers.ToDictionary(c => c.Id, c => c.DisplayName);

        _loading = false;
    }

    private void SelectFilter(FilterKey key)
    {
        _activeFilter = key;
        _page = 0;
        // No explicit StateHasChanged needed — @onclick re-renders the component.
    }

    private void ToggleSort(SortColumn col)
    {
        if (_sortColumn == col)
        {
            _sortDirection = _sortDirection == SortDirection.Asc ? SortDirection.Desc : SortDirection.Asc;
        }
        else
        {
            _sortColumn = col;
            _sortDirection = SortDirection.Asc;
        }
    }

    private IEnumerable<RentInvoice> FilterRows(IEnumerable<RentInvoice> rows)
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        return _activeFilter switch
        {
            FilterKey.Open     => rows.Where(i => i.Status == RentInvoiceStatus.Open),
            FilterKey.Overdue  => rows.Where(i => i.Status == RentInvoiceStatus.Open && i.DueDate < today),
            FilterKey.Paid     => rows.Where(i => i.Status == RentInvoiceStatus.Paid),
            FilterKey.Unlinked => rows.Where(i => i.LeaseId is null),
            _                  => rows
        };
    }

    private IEnumerable<RentInvoice> SearchRows(IEnumerable<RentInvoice> rows)
    {
        if (string.IsNullOrWhiteSpace(_search)) return rows;
        var needle = _search.Trim();
        return rows.Where(i =>
            CustomerName(i.CustomerId).Contains(needle, StringComparison.OrdinalIgnoreCase)
         || (i.ExternalDocNumber ?? i.Id.ToString()).Contains(needle, StringComparison.OrdinalIgnoreCase));
    }

    private List<RentInvoice> SortRows(IEnumerable<RentInvoice> rows)
    {
        Func<RentInvoice, IComparable> key = _sortColumn switch
        {
            SortColumn.InvoiceNumber => i => i.ExternalDocNumber ?? i.Id.ToString("D10"),
            SortColumn.Customer      => i => CustomerName(i.CustomerId),
            SortColumn.Amount        => i => i.TotalAmount,
            SortColumn.Balance       => i => i.Balance,
            SortColumn.Status        => i => StatusRank(i),
            SortColumn.Lease         => i => i.LeaseId ?? int.MaxValue,
            _                        => i => i.DueDate.DayNumber
        };
        return _sortDirection == SortDirection.Asc
            ? rows.OrderBy(key).ToList()
            : rows.OrderByDescending(key).ToList();
    }

    // Stable sort ordering for the Status pill: overdue first (loudest signal),
    // then open, then paid, then voided.
    private int StatusRank(RentInvoice i)
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        if (i.Status == RentInvoiceStatus.Open && i.DueDate < today) return 0;
        if (i.Status == RentInvoiceStatus.Open)                      return 1;
        if (i.Status == RentInvoiceStatus.Paid)                      return 2;
        return 3;
    }

    private int CountFor(FilterKey key)
    {
        // Counts respect the search box but ignore the filter — so the chips
        // show "Paid 11" no matter which filter is active. That way the user
        // can see at a glance what's behind each chip without clicking.
        var pool = string.IsNullOrWhiteSpace(_search) ? _all : SearchRows(_all).ToList();
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        return key switch
        {
            FilterKey.Open     => pool.Count(i => i.Status == RentInvoiceStatus.Open),
            FilterKey.Overdue  => pool.Count(i => i.Status == RentInvoiceStatus.Open && i.DueDate < today),
            FilterKey.Paid     => pool.Count(i => i.Status == RentInvoiceStatus.Paid),
            FilterKey.Unlinked => pool.Count(i => i.LeaseId is null),
            _                  => pool.Count()
        };
    }

    private string CustomerName(int id) =>
        _customerNames.TryGetValue(id, out var n) ? n : $"Customer #{id}";

    // Maps an invoice to an Osen badge family (the .dot inherits currentColor).
    private string StatusBadge(RentInvoice i)
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        if (i.Status == RentInvoiceStatus.Paid)   return "badge-success";
        if (i.Status == RentInvoiceStatus.Voided) return "badge-neutral";
        if (i.DueDate < today)                    return "badge-danger";
        return "badge-warning";
    }

    private string StatusLabel(RentInvoice i)
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        if (i.Status == RentInvoiceStatus.Paid)   return "Paid";
        if (i.Status == RentInvoiceStatus.Voided) return "Voided";
        if (i.DueDate < today)                    return "Overdue";
        return "Open";
    }
}
