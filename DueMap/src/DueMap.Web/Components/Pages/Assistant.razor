@page "/assistant"
@using DueMap.Web.Services.Assistant
@inject AssistantService AssistantSvc
@inject IJSRuntime JS
@inject ILogger<Assistant> Log

<PageTitle>Assistant — DueMap</PageTitle>

<div class="max-w-3xl mx-auto px-6 md:px-8 py-8 space-y-5">

    <div>
        <h2 class="page-title">Assistant</h2>
        <p class="mt-1.5 text-sm text-muted leading-relaxed max-w-2xl">
            Ask questions about your portfolio in plain English — who's overdue, which leases expire soon,
            a tenant's payment history. Answers come from your own synced data and are read-only.
        </p>
    </div>

    @if (!AssistantSvc.IsConfigured)
    {
        <div class="rounded-card border border-dashed border-line p-10 text-center">
            <p class="text-sm font-medium text-heading mb-1">The assistant isn't configured yet.</p>
            <p class="text-sm text-muted">
                Add a Claude API key to the shared secrets pool and restart:
            </p>
            <p class="mt-3 font-mono text-xs text-body bg-surface-2 inline-block rounded px-3 py-2">
                dotnet user-secrets set Anthropic:ApiKey &lt;your-key&gt;
            </p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="p-4 md:p-5 space-y-4 min-h-[280px]">
                @if (_messages.Count == 0)
                {
                    <div class="text-center py-6">
                        <p class="text-sm text-muted mb-4">Try one of these to get started:</p>
                        <div class="flex flex-wrap justify-center gap-2">
                            @foreach (var s in _suggestions)
                            {
                                <button type="button" class="btn btn-sm btn-secondary"
                                        @onclick="@(() => SendAsync(s))" disabled="@_busy">
                                    @s
                                </button>
                            }
                        </div>
                    </div>
                }

                @foreach (var msg in _messages)
                {
                    @if (msg.IsUser)
                    {
                        <div class="flex justify-end">
                            <div class="max-w-[85%] rounded-card bg-primary text-primary-contrast text-sm px-4 py-2.5 whitespace-pre-wrap">@msg.Text</div>
                        </div>
                    }
                    else if (msg.IsError)
                    {
                        <div class="flex">
                            <div class="max-w-[85%] rounded-card bg-danger-soft text-danger-soft-fg text-sm px-4 py-2.5 whitespace-pre-wrap">@msg.Text</div>
                        </div>
                    }
                    else
                    {
                        <div class="flex">
                            <div class="max-w-[85%] rounded-card bg-surface-2 text-body text-sm px-4 py-2.5 whitespace-pre-wrap leading-relaxed">@msg.Text</div>
                        </div>
                    }
                }

                @if (_busy)
                {
                    <div class="flex items-center gap-2 text-sm text-muted">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                        <span>@_activity</span>
                    </div>
                }
            </div>

            <div class="border-t border-line p-3 md:p-4">
                <form @onsubmit="OnSubmitAsync" @onsubmit:preventDefault>
                    <div class="flex gap-2">
                        <input type="text" placeholder="Ask about your portfolio…"
                               @bind="_input" @bind:event="oninput"
                               disabled="@_busy"
                               class="form-control flex-1" />
                        <button type="submit" class="btn btn-primary"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_input))">
                            Send
                        </button>
                    </div>
                </form>
                <div class="mt-2 flex items-center justify-between">
                    <p class="text-[11px] text-muted">
                        AI-generated from your synced data — verify anything important before acting on it.
                    </p>
                    @if (_messages.Count > 0)
                    {
                        <button type="button" class="text-[11px] text-muted hover:text-body underline"
                                @onclick="ClearConversation" disabled="@_busy">
                            Clear conversation
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private sealed record ChatMessage(string Text, bool IsUser, bool IsError = false);

    private readonly List<ChatMessage> _messages = new();
    private string _input = "";
    private bool _busy;
    private string _activity = "Thinking…";

    private static readonly string[] _suggestions =
    {
        "Who is overdue on rent right now?",
        "Give me a portfolio summary",
        "Which leases expire in the next 90 days?",
        "Which tenants are on autopay?"
    };

    private async Task OnSubmitAsync()
    {
        var text = _input.Trim();
        if (text.Length == 0 || _busy) return;
        _input = "";
        await SendAsync(text);
    }

    private async Task SendAsync(string text)
    {
        _messages.Add(new ChatMessage(text, IsUser: true));
        _busy = true;
        _activity = "Thinking…";
        StateHasChanged();
        await ScrollToBottomAsync();

        try
        {
            // Activity callbacks arrive from the awaiting context between tool
            // calls; InvokeAsync marshals the re-render onto the circuit.
            var answer = await AssistantSvc.AskAsync(text, activity =>
            {
                _activity = activity;
                _ = InvokeAsync(StateHasChanged);
            }, CancellationToken.None);

            _messages.Add(new ChatMessage(answer, IsUser: false));
        }
        catch (Anthropic.Exceptions.AnthropicRateLimitException)
        {
            _messages.Add(new ChatMessage(
                "The assistant is rate-limited right now — wait a moment and try again.",
                IsUser: false, IsError: true));
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Assistant request failed");
            _messages.Add(new ChatMessage(
                "Something went wrong answering that. The error has been logged — try again, or rephrase the question.",
                IsUser: false, IsError: true));
        }
        finally
        {
            _busy = false;
            StateHasChanged();
            await ScrollToBottomAsync();
        }
    }

    private void ClearConversation()
    {
        AssistantSvc.ResetConversation();
        _messages.Clear();
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollTo", new { top = 999999, behavior = "smooth" });
        }
        catch
        {
            // Prerender / disconnected circuit — scrolling is cosmetic, ignore.
        }
    }
}
