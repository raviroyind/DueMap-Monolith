    // Maps lease status to an Osen badge family (the .dot inherits currentColor).
    private static string StatusBadge(LeaseStatus s) => s switch
    {
        LeaseStatus.Current        => "badge-success",
        LeaseStatus.InGrace        => "badge-warning",
        LeaseStatus.Overdue        => "badge-danger",
        LeaseStatus.LateFeePosted  => "badge-danger font-semibold",
        _ => "badge-neutral"
    };

    private static string StatusLabel(Row r) => r.Status switch
    {
        LeaseStatus.Current        => "Current",
        LeaseStatus.InGrace        => $"In grace · {r.DaysPastDue}d",
        LeaseStatus.Overdue        => $"Overdue {r.DaysPastDue}d",
        LeaseStatus.LateFeePosted  => "Late fee posted",
        _ => "—"
    };

    private static string ChannelDotClass(NoticeChannel? c) => c switch
    {
        NoticeChannel.Email => "w-1.5 h-1.5 rounded-full bg-primary",
        NoticeChannel.Sms   => "w-1.5 h-1.5 rounded-full bg-success",
        _                   => "w-1.5 h-1.5 rounded-full bg-muted"
    };

    private static string RelativeTime(DateTime utc)
    {
        var delta = DateTime.UtcNow - utc;
        if (delta.TotalMinutes < 1)  return "just now";
        if (delta.TotalMinutes < 60) return $"{(int)delta.TotalMinutes}m ago";
        if (delta.TotalHours   < 24) return $"{(int)delta.TotalHours}h ago";
        if (delta.TotalDays    < 7)  return $"{(int)delta.TotalDays}d ago";
        return utc.ToString("yyyy-MM-dd");
    }

    // --- selection + bulk modal (unchanged behavior) ---------------------

    private void ToggleOne(int leaseId, ChangeEventArgs e)
    {
        if (e.Value is true)  _selected.Add(leaseId);
        else                  _selected.Remove(leaseId);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            foreach (var r in _filtered) _selected.Add(r.Lease.Id);
        }
        else
        {
            _selected.Clear();
        }
    }

    private void ClearSelection() => _selected.Clear();

    private void OpenBulkModal()
    {
        _patch = new PatchModel();
        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private async Task ApplyBulk()
    {
        if (_selected.Count == 0) { _showModal = false; return; }
        _applying = true;
        try
        {
            var ids = _selected.ToList();
            var patch = _patch.ToPatch();
            var n = await SettingsService.BulkApplyAsync(ids, patch, CancellationToken.None);
            _toast = $"Applied to {ids.Count} lease(s), {n} row(s) written.";
            _showModal = false;
            await LoadAsync();
        }
        finally
        {
            _applying = false;
        }
    }

    // --- New lease modal -------------------------------------------------

    private sealed class NewLeaseForm
    {
        public int CustomerId { get; set; }       // 0 = no selection
        public int StateId    { get; set; }       // 0 = no selection
        public decimal MonthlyRent { get; set; }
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime? EndDate  { get; set; }
    }

    private void OpenNewLeaseModal()
    {
        _newLease = new NewLeaseForm { StartDate = DateTime.Today };
        _newLeaseError = null;
        _showNewLeaseModal = true;
    }

    private void CloseNewLeaseModal()
    {
        _showNewLeaseModal = false;
        _newLeaseError = null;
    }

    private async Task CreateLeaseAsync()
    {
        if (_pmId is not int pmId) return;
        _newLeaseError = null;

        if (_newLease.StateId == 0)        { _newLeaseError = "Pick a state."; return; }
        if (_newLease.MonthlyRent <= 0m)   { _newLeaseError = "Monthly rent must be positive."; return; }

        _creatingLease = true;
        try
        {
            var input = new NewLeaseInput(
                PropertyManagerId: pmId,
                StateId: _newLease.StateId,
                CustomerId: _newLease.CustomerId == 0 ? null : _newLease.CustomerId,
                MonthlyRent: _newLease.MonthlyRent,
                StartDate: DateOnly.FromDateTime(_newLease.StartDate),
                EndDate: _newLease.EndDate is DateTime end ? DateOnly.FromDateTime(end) : null);

            var lease = await LeaseWriter.CreateAsync(input, CancellationToken.None);
            _toast = $"Lease #{lease.Id} created.";
            _showNewLeaseModal = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _newLeaseError = ex.Message;
        }
        finally
        {
            _creatingLease = false;
        }
    }

    private sealed class PatchModel
    {
        public bool SetPreDueEnabled { get; set; }
        public bool PreDueEnabled { get; set; } = true;

        public bool SetPreDueDays { get; set; }
        public int PreDueDays { get; set; } = 3;

        public bool SetDueDateEnabled { get; set; }
        public bool DueDateEnabled { get; set; } = true;

        public bool SetPostDueEnabled { get; set; }
        public bool PostDueEnabled { get; set; } = true;

        public bool SetPostDueMode { get; set; }
        public PostDueMode PostDueMode { get; set; } = DueMap.Tenancy.Domain.PostDueMode.GracePeriod;

        public bool SetPostDueGraceDays { get; set; }
        public int PostDueGraceDays { get; set; } = 5;

        public LeaseNoticeSettingsPatch ToPatch() => new()
        {
            PreDueEnabled    = SetPreDueEnabled    ? PreDueEnabled    : null,
            PreDueDaysBefore = SetPreDueDays       ? PreDueDays       : null,
            DueDateEnabled   = SetDueDateEnabled   ? DueDateEnabled   : null,
            PostDueEnabled   = SetPostDueEnabled   ? PostDueEnabled   : null,
            PostDueMode      = SetPostDueMode      ? PostDueMode      : null,
            PostDueGraceDays = SetPostDueGraceDays ? PostDueGraceDays : null
        };
    }
