@page "/templates"
@using DueMap.Notices
@using DueMap.Notices.Domain
@using DueMap.Rules
@using RulesState = DueMap.Rules.Domain.State
@using DueMap.Web.Components.Shared
@using DueMap.Web.Services
@inject PmContext Pm
@inject ToastService Toast
@inject IPmTemplateOverrideService Overrides
@inject INoticeTypeReader NoticeTypes
@inject IStateReader States

<PageTitle>Templates — DueMap</PageTitle>

<div class="max-w-5xl mx-auto px-6 md:px-8 py-8 space-y-6">

    <div>
        <h2 class="page-title">Templates</h2>
        <p class="mt-1.5 text-sm text-muted max-w-2xl leading-relaxed">
            Custom subject/body per notice type. Layered:
            <strong class="font-medium text-heading">state-specific override</strong>
            <span class="text-muted">›</span>
            <strong class="font-medium text-heading">generic PM override</strong>
            <span class="text-muted">›</span>
            <strong class="font-medium text-heading">system default</strong>.
            Required legal placeholders stay enforced — you can rewrite copy but cannot drop them.
        </p>
    </div>

    @if (_pmId is null)
    {
        <p class="text-muted">Loading…</p>
    }
    else
    {
        <!-- LIST -->
        <section class="card">
            <header class="card-header flex items-center justify-between gap-3">
                <div>
                    <div class="card-title">Existing overrides</div>
                    <div class="card-subtitle">Active customizations across notice types and states.</div>
                </div>
                <button class="btn btn-sm btn-primary" @onclick="OpenNewAsync">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    New override
                </button>
            </header>

            @if (_existing.Count == 0)
            {
                <div class="px-6 py-12 text-center">
                    <p class="text-sm text-muted">No overrides yet — system templates will be used for all notices.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Notice type</th>
                                <th>State</th>
                                <th>Subject</th>
                                <th>Updated</th>
                                <th class="w-40"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in _existing)
                            {
                                <tr>
                                    <td class="cell-strong">@TypeName(o.NoticeTypeId)</td>
                                    <td>@(o.StateId.HasValue ? StateCode(o.StateId.Value) : "All states")</td>
                                    <td class="font-mono text-xs">@Truncate(o.Subject, 60)</td>
                                    <td class="text-muted tabular">@FriendlyTime.Utc(o.UpdatedAt)</td>
                                    <td class="text-right">
                                        <button class="btn btn-sm btn-secondary" @onclick="@(() => OpenExistingAsync(o))">Edit</button>
                                        <button class="btn btn-sm btn-link text-danger" @onclick="@(() => Deactivate(o.Id))">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@* Shared template editor — same modal NoticePreferences uses. Single source of
   truth for the keyword chips + design/preview tabs + theme picker. *@
@if (_pmId is int pmId)
{
    <EditTemplateModal @ref="_modal" PropertyManagerId="pmId" OnSaved="OnTemplateSavedAsync" />
}

@code {
    private int? _pmId;
    private List<PmTemplateOverride> _existing = new();
    private IReadOnlyList<NoticeType> _noticeTypes = Array.Empty<NoticeType>();
    private IReadOnlyList<RulesState> _states = Array.Empty<RulesState>();
    private EditTemplateModal? _modal;

    protected override async Task OnInitializedAsync()
    {
        _pmId = await Pm.GetPmIdAsync();
        _noticeTypes = await NoticeTypes.ListAllAsync(CancellationToken.None);
        _states = await States.ListAllAsync(CancellationToken.None);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_pmId is not int id) return;
        _existing = (await Overrides.ListForPmAsync(id, CancellationToken.None))
            .Where(o => o.IsActive)
            .ToList();
        StateHasChanged();
    }

    private async Task OpenNewAsync()
    {
        if (_modal is null) return;
        await _modal.ShowNewWithPickerAsync();
    }

    private async Task OpenExistingAsync(PmTemplateOverride row)
    {
        if (_modal is null) return;
        await _modal.ShowExistingAsync(row);
    }

    private async Task OnTemplateSavedAsync()
    {
        Toast.Success("Template saved.");
        await LoadAsync();
    }

    private async Task Deactivate(int id)
    {
        await Overrides.DeactivateAsync(id, CancellationToken.None);
        Toast.Success($"Removed override #{id}.");
        await LoadAsync();
    }

    private string TypeName(int id) =>
        _noticeTypes.FirstOrDefault(t => t.Id == id)?.DisplayName ?? $"#{id}";

    private string StateCode(int id) =>
        _states.FirstOrDefault(s => s.Id == id)?.Code ?? $"#{id}";

    private static string Truncate(string s, int n) => s.Length <= n ? s : s[..n] + "…";
}
