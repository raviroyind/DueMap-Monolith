@page
@model DueMap.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
    ViewData["Subtitle"] = "Set up your property manager workspace";

    // Build the password checklist from the real Identity policy so the live
    // (client-side) feedback can never claim "valid" for something the server
    // would reject. Each entry: (rule key the JS validator uses, label, length).
    var pw = Model.Password;
    var pwRules = new List<(string Key, string Label, int Len)>();
    if (pw.RequiredLength > 0)        pwRules.Add(("len",     $"At least {pw.RequiredLength} characters", pw.RequiredLength));
    if (pw.RequireUppercase)          pwRules.Add(("upper",   "One uppercase letter", 0));
    if (pw.RequireLowercase)          pwRules.Add(("lower",   "One lowercase letter", 0));
    if (pw.RequireDigit)              pwRules.Add(("digit",   "One number", 0));
    if (pw.RequireNonAlphanumeric)    pwRules.Add(("special", "One special character", 0));
    if (pw.RequiredUniqueChars > 1)   pwRules.Add(("unique",  $"{pw.RequiredUniqueChars} different characters", pw.RequiredUniqueChars));
}

@if (TempData["SsoNotice"] is string ssoNotice)
{
    <div class="alert alert-primary mb-5">@ssoNotice</div>
}

<partial name="_SsoButtons" model="@("signup")" />

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger mb-6">
        <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        <div class="flex-1 min-w-0 font-medium">@Model.ErrorMessage</div>
    </div>
}

<form method="post" class="space-y-5">
    @* Organization name is intentionally NOT collected here. We pull the real
       company name from the connected accounting system (QuickBooks /
       Xero) during onboarding step 1 — see task #61. Until that step runs,
       the PM row is named after the email's local-part as a readable
       placeholder; see Register.cshtml.cs DeriveTemporaryName. *@
    <div>
        <label for="email" class="form-label">Email</label>
        <input id="email" type="email" asp-for="Input.Email" required autofocus
               placeholder="you@example.com" class="form-control" />
    </div>

    <div>
        <label for="password" class="form-label">Password</label>
        <input id="password" type="password" asp-for="Input.Password" required class="form-control" autocomplete="new-password" />
        <ul id="pw-rules" class="mt-2 space-y-1.5" aria-live="polite">
            @foreach (var r in pwRules)
            {
                <li class="pw-rule flex items-center gap-2 text-xs text-muted transition-colors" data-rule="@r.Key" data-len="@r.Len">
                    <span class="pw-ico inline-flex w-4 h-4 items-center justify-center shrink-0"></span>
                    <span>@r.Label</span>
                </li>
            }
        </ul>
    </div>

    <div>
        <label for="confirm" class="form-label">Confirm password</label>
        <input id="confirm" type="password" asp-for="Input.ConfirmPassword" required class="form-control" autocomplete="new-password" />
        <p id="pw-match" class="pw-rule mt-2 flex items-center gap-2 text-xs text-muted transition-colors" data-rule="match" style="display:none">
            <span class="pw-ico inline-flex w-4 h-4 items-center justify-center shrink-0"></span>
            <span>Passwords match</span>
        </p>
    </div>

    <button id="pw-submit" type="submit" class="btn btn-primary w-full">
        Create account
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </button>

    <p class="form-hint leading-relaxed">
        By creating an account you agree to the
        <a href="#" class="text-primary">Terms</a>
        and
        <a href="#" class="text-primary">Privacy Policy</a>.
    </p>
</form>

<p class="mt-6 text-center text-sm text-muted">
    Already have an account?
    <a asp-page="/Account/Login" class="font-medium text-primary">Sign in</a>
</p>

<script src="/js/password-checklist.js"></script>
