@page
@model DueMap.Web.Pages.Account.RegisterConfirmationModel
@{
    ViewData["Title"] = "Check your email";
    ViewData["Subtitle"] = "One last step";
}

<div class="text-center space-y-4">
    <span class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-primary-soft text-primary-soft-fg">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
    </span>
    <div>
        <h2 class="text-lg font-semibold text-heading">Confirm your email</h2>
        <p class="mt-1 text-sm text-muted">
            We sent a confirmation link@(string.IsNullOrWhiteSpace(Model.Email) ? "" : " to") <span class="font-medium text-heading">@Model.Email</span>.
            Click it to activate your account — until then you won't be able to sign in.
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Notice))
{
    <div class="alert alert-success mt-5">@Model.Notice</div>
}

<form method="post" asp-page-handler="Resend" class="mt-6 space-y-3">
    <input type="hidden" asp-for="Email" />
    <button type="submit" class="btn btn-secondary w-full">Resend confirmation email</button>
</form>

<p class="mt-6 text-center text-sm text-muted">
    Already confirmed?
    <a asp-page="/Account/Login" class="font-medium text-primary">Sign in</a>
</p>
