@page
@model DueMap.Web.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
    ViewData["Subtitle"] = Model.Confirmed ? "Your account is active" : "Confirmation link";
}

@if (Model.Confirmed)
{
    <div class="text-center space-y-4">
        <span class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-success-soft text-success-soft-fg">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <div>
            <h2 class="text-lg font-semibold text-heading">Email confirmed</h2>
            <p class="mt-1 text-sm text-muted">Your DueMap account is now active.</p>
        </div>
        <a href="/" class="btn btn-primary w-full">
            Continue to DueMap
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
    </div>
}
else
{
    <div class="text-center space-y-4">
        <span class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-danger-soft text-danger-soft-fg">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        </span>
        <div>
            <h2 class="text-lg font-semibold text-heading">This link didn't work</h2>
            <p class="mt-1 text-sm text-muted">The confirmation link is invalid or has expired. Request a fresh one and try again.</p>
        </div>
        <a asp-page="/Account/RegisterConfirmation" class="btn btn-secondary w-full">Resend confirmation link</a>
        <p class="text-sm text-muted">
            <a asp-page="/Account/Login" class="font-medium text-primary">Back to sign in</a>
        </p>
    </div>
}
