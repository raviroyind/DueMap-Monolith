@page
@model DueMap.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = Model.Succeeded ? "Password updated"
                      : Model.LinkInvalid ? "Link expired"
                      : "Choose a new password";
    ViewData["Subtitle"] = Model.Succeeded || Model.LinkInvalid ? "" : "Almost done";
}

@if (Model.Succeeded)
{
    <div class="text-center space-y-4">
        <span class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-success-soft text-success">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <div>
            <h2 class="text-lg font-semibold text-heading">Password updated</h2>
            <p class="mt-1 text-sm text-muted">
                Your new password is active. Sign in with it to get back into DueMap.
            </p>
        </div>
    </div>

    <a asp-page="/Account/Login" class="btn btn-primary w-full mt-6">
        Sign in
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
}
else if (Model.LinkInvalid)
{
    <div class="text-center space-y-4">
        <span class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-danger-soft text-danger-soft-fg">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
        </span>
        <div>
            <h2 class="text-lg font-semibold text-heading">This link has expired</h2>
            <p class="mt-1 text-sm text-muted">
                Reset links last one hour and work only once. Request a fresh one and we'll email it straight over.
            </p>
        </div>
    </div>

    <a asp-page="/Account/ForgotPassword" class="btn btn-primary w-full mt-6">
        Request a new link
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
}
else
{
    <form method="post" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <input type="hidden" asp-for="Input.UserId" />
        <input type="hidden" asp-for="Input.Token" />

        <div>
            <label for="password" class="form-label">New password</label>
            <input id="password" type="password" asp-for="Input.Password" required autofocus
                   class="form-control" />
            <span class="form-hint">At least 8 characters.</span>
            <span asp-validation-for="Input.Password" class="form-hint text-danger"></span>
        </div>

        <div>
            <label for="confirmPassword" class="form-label">Confirm new password</label>
            <input id="confirmPassword" type="password" asp-for="Input.ConfirmPassword" required
                   class="form-control" />
            <span asp-validation-for="Input.ConfirmPassword" class="form-hint text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-full">
            Update password
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
    </form>

    <p class="mt-6 text-center text-sm text-muted">
        <a asp-page="/Account/Login" class="font-medium text-primary">Back to sign in</a>
    </p>
}
