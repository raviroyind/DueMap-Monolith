@page
@model DueMap.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = Model.Submitted ? "Check your email" : "Reset your password";
    ViewData["Subtitle"] = Model.Submitted ? "" : "We'll email you a link";
}

@if (Model.Submitted)
{
    @* Deliberately identical whether or not the address has an account. *@
    <div class="text-center space-y-4">
        <span class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-primary-soft text-primary-soft-fg">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </span>
        <div>
            <h2 class="text-lg font-semibold text-heading">Check your email</h2>
            <p class="mt-1 text-sm text-muted">
                If an account exists for <span class="font-medium text-heading">@Model.Input.Email</span>,
                we've sent a link to choose a new password. It expires in one hour.
            </p>
        </div>
    </div>

    <p class="mt-6 text-center text-sm text-muted">
        Didn't get it? Check your spam folder, or
        <a asp-page="/Account/ForgotPassword" class="font-medium text-primary">try another address</a>.
    </p>
}
else
{
    <form method="post" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <p class="text-sm text-muted">
            Enter the email address on your DueMap account and we'll send you a link to set a new password.
        </p>

        <div>
            <label for="email" class="form-label">Email</label>
            <input id="email" type="email" asp-for="Input.Email" required autofocus
                   placeholder="you@example.com" class="form-control" />
            <span asp-validation-for="Input.Email" class="form-hint text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-full">
            Send reset link
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
    </form>

    <p class="mt-6 text-center text-sm text-muted">
        Remembered it?
        <a asp-page="/Account/Login" class="font-medium text-primary">Back to sign in</a>
    </p>
}
