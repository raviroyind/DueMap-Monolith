@page
@model DueMap.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["Subtitle"] = "Sign in to your property manager account";
}

@if (TempData["SsoNotice"] is string ssoNotice)
{
    <div class="alert alert-primary mb-5">@ssoNotice</div>
}

@* OIDC RemoteFailure handler bounces us back here with ?sso_error=... so the
   user gets actionable feedback ("Sender unverified", "Bad client id", etc.)
   instead of a stack trace. *@
@if (!string.IsNullOrEmpty(Request.Query["sso_error"]))
{
    <div class="alert alert-danger mb-5">
        <div>
            <div class="alert-title">Single sign-on failed</div>
            <div class="text-xs mt-1 break-words">@Request.Query["sso_error"]</div>
        </div>
    </div>
}

<partial name="_SsoButtons" model="@("signin")" />

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger mb-6">
        <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        <div class="flex-1 min-w-0 font-medium">@Model.ErrorMessage</div>
    </div>
}

<form method="post" class="space-y-5">
    <div>
        <label for="email" class="form-label">Email</label>
        <input id="email" type="email" asp-for="Input.Email" required autofocus
               placeholder="you@example.com" class="form-control" />
    </div>

    <div>
        <div class="flex items-center justify-between mb-1.5">
            <label for="password" class="form-label mb-0">Password</label>
            <a href="#" class="btn-link text-xs">Forgot?</a>
        </div>
        <input id="password" type="password" asp-for="Input.Password" required class="form-control" />
    </div>

    <label class="form-check">
        <input type="checkbox" asp-for="Input.RememberMe" />
        <span class="text-sm">Keep me signed in for 14 days</span>
    </label>

    <button type="submit" class="btn btn-primary w-full">
        Sign in
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </button>
</form>

<p class="mt-6 text-center text-sm text-muted">
    New to DueMap?
    <a asp-page="/Account/Register" class="font-medium text-primary">Create a property manager account</a>
</p>
