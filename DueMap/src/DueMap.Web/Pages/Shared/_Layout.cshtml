@{
    var title = ViewData["Title"] as string ?? "DueMap";
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title — DueMap</title>
    <link rel="stylesheet" href="~/css/app.css" />
    <script src="~/js/theme.js"></script>
</head>
<body class="h-full font-sans antialiased bg-stone-50 text-zinc-900 dark:bg-zinc-950 dark:text-zinc-50">

    <button onclick="dueMapTheme.toggle()"
            class="fixed top-4 right-4 z-50 p-2 rounded-lg text-zinc-500 hover:bg-white/70 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 backdrop-blur-sm transition-colors duration-150"
            aria-label="Toggle theme">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>

    <main class="auth-bg relative min-h-full flex flex-col items-center justify-center px-4 py-12">
        <div class="relative w-full max-w-md">

            <!-- Brand mark + product name -->
            <div class="flex flex-col items-center mb-8">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-700 flex items-center justify-center shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
                </div>
                <h1 class="mt-4 text-2xl font-semibold tracking-tight">DueMap</h1>
                @if (ViewData["Subtitle"] is string sub)
                {
                    <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">@sub</p>
                }
            </div>

            <!-- Card -->
            <div class="rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/60 dark:border-zinc-800 shadow-sm p-8">
                @RenderBody()
            </div>

            <!-- Footer -->
            <div class="mt-12 flex items-center justify-center gap-4 text-xs text-zinc-400 dark:text-zinc-500">
                <a href="#" class="hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">Terms</a>
                <span class="w-px h-3 bg-zinc-300 dark:bg-zinc-700"></span>
                <a href="#" class="hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">Privacy</a>
                <span class="w-px h-3 bg-zinc-300 dark:bg-zinc-700"></span>
                <a href="#" class="hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">Status</a>
            </div>
        </div>
    </main>

</body>
</html>
