@page "/t/set-password"
@model DueMap.Web.Pages.Tenant.SetPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Set a password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body class="min-h-screen bg-stone-50 text-zinc-900 dark:bg-zinc-950 dark:text-zinc-100">
<div class="max-w-md mx-auto px-6 py-16">
    <h1 class="text-xl font-semibold tracking-tight">Set a password</h1>
    <p class="mt-1 text-sm text-zinc-500">Optional. With a password you can sign in instantly next time instead of waiting for a magic-link email.</p>

    @if (Model.SignedOut)
    {
        <div class="mt-6 rounded-xl border border-amber-200/70 dark:border-amber-500/20 bg-amber-50/60 dark:bg-amber-500/5 px-4 py-3 text-sm text-amber-900 dark:text-amber-200">
            You're not signed in. <a href="/t/login" class="font-medium underline">Sign in</a> and try again.
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mt-6 rounded-xl border border-rose-200/70 dark:border-rose-500/20 bg-rose-50/60 dark:bg-rose-500/5 px-4 py-3 text-sm text-rose-900 dark:text-rose-200">@Model.ErrorMessage</div>
        }

        <form method="post" class="mt-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-sm p-6 space-y-4">
            <div>
                <label for="new" class="block text-sm font-medium mb-1.5">New password</label>
                <input id="new" type="password" asp-for="Input.NewPassword" required autofocus minlength="8"
                       class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-zinc-800 text-sm border border-zinc-200 dark:border-zinc-700 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20" />
                <p class="mt-1.5 text-xs text-zinc-500">At least 8 characters.</p>
            </div>
            <div>
                <label for="confirm" class="block text-sm font-medium mb-1.5">Confirm password</label>
                <input id="confirm" type="password" asp-for="Input.ConfirmPassword" required minlength="8"
                       class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-zinc-800 text-sm border border-zinc-200 dark:border-zinc-700 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20" />
            </div>
            <button type="submit"
                    class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm">
                Save password
            </button>
            <a href="/t/profile" class="block text-center text-xs text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-300">Cancel</a>
        </form>
    }
</div>
</body>
</html>
