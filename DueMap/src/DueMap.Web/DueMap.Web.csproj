<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>DueMap.Web</RootNamespace>
    <!-- Web and Worker share one local secrets pool so credentials set with
         `dotnet user-secrets` are visible to both processes. Both projects
         must keep this value identical or one process will silently see no
         secrets in Development. -->
    <UserSecretsId>DueMap.dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DueMap.Common\DueMap.Common.csproj" />
    <ProjectReference Include="..\Modules\DueMap.Identity\DueMap.Identity.csproj" />
    <ProjectReference Include="..\Modules\DueMap.Tenancy\DueMap.Tenancy.csproj" />
    <ProjectReference Include="..\Modules\DueMap.Rules\DueMap.Rules.csproj" />
    <ProjectReference Include="..\Modules\DueMap.Notices\DueMap.Notices.csproj" />
    <ProjectReference Include="..\Modules\DueMap.Billing\DueMap.Billing.csproj" />
    <ProjectReference Include="..\Modules\DueMap.Integrations\DueMap.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.10" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

  <!-- Tell MSBuild to track input.css and re-compile when it (or any razor file)
       changes. Tailwind itself does content scanning, but we list explicit
       inputs so incremental builds don't re-run when nothing relevant changed. -->
  <ItemGroup>
    <TailwindInput Include="wwwroot/css/input.css" />
    <TailwindInput Include="Components/**/*.razor" />
    <TailwindInput Include="Pages/**/*.cshtml" />
  </ItemGroup>

  <!-- Compile Tailwind CSS before the .NET build copies content to bin/.
       Skipped if the input file is missing (e.g. fresh checkout without
       `npm install`); a warning is emitted instead of a build break. -->
  <Target Name="BuildTailwindCss"
          BeforeTargets="GenerateBuildDependencyFile;Build"
          Inputs="@(TailwindInput)"
          Outputs="wwwroot/css/app.css">
    <PropertyGroup>
      <SolutionRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</SolutionRoot>
    </PropertyGroup>
    <Message Text="Compiling Tailwind CSS (input.css → app.css)…" Importance="high" />
    <Exec Command="npx @tailwindcss/cli -i src/DueMap.Web/wwwroot/css/input.css -o src/DueMap.Web/wwwroot/css/app.css --minify"
          WorkingDirectory="$(SolutionRoot)"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
